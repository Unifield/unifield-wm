<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    <!-- Period choice wizard -->
        <record id="wizard_liquidity_report_view" model="ir.ui.view">
            <field name="name">wizard.liquidity.report.view</field>
            <field name="model">wizard.liquidity.report</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Liquidity Report">
                    <separator colspan="4" string="Information" />
                    <label string="Please choose a period." colspan="4" align="0.0"/>
                    <field name="period_id" colspan="2" domain="[('currency_table_id', '=', False), ('active', 'in', ['True', 'False'])]"/>
                    <group col="4" colspan="6">
                        <label string="" colspan="1"/>
                        <button special="cancel" string="Cancel" icon="gtk-cancel" colspan="1"/>
                        <button name="button_run_liquidity_report" type="object" string="Run report" icon="gtk-ok" colspan="1"/>
                    </group>
                </form>
            </field>
        </record>

    </data>
</openerp>
