<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="stock_move_select_asset_form_view" model="ir.ui.view">
            <field name="name">stock.move.select.asset.form.view</field>
            <field name="model">stock.move.select.asset</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Move multiple assets">
                    <field name="product_id" invisible="1" />
                    <field name="location_id" invisible="1" />
                    <field name="create_or_select" invisible="0" />
                    <separator colspan="4" string="Move information" />
                    <field name="move_processor_id" readonly="0" />
                    <separator colspan="4" string="Assets" />
                    <field name="asset_ids"
                           nolabel="1"
                           colspan="4"
                           domain="[('product_id', '=', product_id), ('is_in_location', '=', location_id)]"
                           context="{
                               'search_default_product_id': product_id,
                               'default_product_id': product_id,
                               'hide_new_button': create_or_select == 'select',
                           }"
                           />
                    <separator colspan="4" string="Actions" />
                    <button name="close_window" icon="gtk-cancel" colspan="2" string="Close window" type="object" />
                    <button name="put_in_processor" icon="gtk-execute" colspan="2" string="Put in wizard" type="object" />
                </form>
            </field>
        </record>

    </data>
</openerp>
