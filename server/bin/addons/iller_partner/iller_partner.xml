<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="inherit_res_partner_form_view1" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view1</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_partner_property_form" />
            <field name="arch" type="xml">
                <page string="Sales &amp; Purchases" position="inside">
                    <group colspan="2" col="2">
                        <separator colspan="2" string="Commentaire Saisib" />
                        <field name="saisib" colspan="2" nolabel="1" />
                    </group>
                </page>
            </field>
        </record>

        <record id="inherit_res_partner_form_view2" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view2</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_partner_property_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Accounting']/group" position="before">
                    <separator colspan="4" string="Informations comptables" />
                    <field name="siret" />
                    <field name="reglement" required="1" />
                    <field name="nb_ex_factures" />
                    <field name="releve" />
                    <separator colspan="4" string="Informations ristourne" />
                    <field name="remise_fac" />
                    <field name="type_ristourne" />
                    <field name="taux_ristourne" />
                    <newline />
                </xpath>
            </field>
        </record>

        <record id="inherit_res_partner_form_view3" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view3</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Sales &amp; Purchases']/field[@name='user_id']" position="after">
                    <field name="appeler_ok" />
                    <field name="tele_user_id" />
                </xpath>
            </field>
        </record>

    </data>
</openerp>
