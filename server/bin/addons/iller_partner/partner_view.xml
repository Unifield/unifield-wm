<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <!-- Suppression de menus -->
        <delete model="ir.ui.menu" search="[('name', '=', 'Partner Addresses')]" />
        <delete model="ir.ui.menu" search="[('name', '=', 'Partners by Categories')]" />
        <delete model="ir.ui.menu" search="[('name', '=', 'Others Partners')]" />

        <!-- Suppression de wizard -->
        <delete model="ir.actions.wizard" search="[('wiz_name', '=', 'res.partner.sms_send'), ('name', '=', 'Send SMS')]" />
        <delete model="ir.actions.wizard" search="[('wiz_name', '=', 'res.partner.spam_send'), ('name', '=', 'Mass Mailing')]" />
        <delete model="ir.values" search="[('model', '=', 'res.partner'), ('name', '=', 'Company Architecture')]" />

        <!-- Suppression de rapports -->
        <delete model="ir.actions.report.xml" search="[('name', '=', 'Labels'), ('model', '=', 'res.partner'), ('report_name', '=', 'res.partner.address')]" />
        <delete model="ir.actions.report.xml" search="[('name', '=', 'Overdue Payments'), ('model', '=', 'res.partner'), ('report_name', '=', 'account.overdue')]" />

        <record id="inherit_res_partner_form_view1" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view1</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <data>
                <page string="Sales &amp; Purchases" position="inside">
                    <group colspan="4" col="2">
                        <separator colspan="2" string="Commentaire Saisib" />
                        <field name="saisib" colspan="2" nolabel="1" />
                    </group>
                </page>
                </data>

            </field>
        </record>

        <record id="inherit_product_partner_form_view" model="ir.ui.view">
            <field name="name">inherit.product.partner.form.view</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.view_partner_property_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="///field[@name='supplier']" position="after">
                        <field name="active" select="2"/>
                    </xpath>
                    <xpath expr="//group[@name='sale_list']/field[@name='property_product_pricelist']" position="replace">
                        <field name="tarif_general_choice" />
                        <field name="prix_noel_choice" />
                        <field name="tarif_special_choice" />
                        <field name="mea_choice" />
                        <field name="promo_choice" />
                        <field name="tarif_choice"/>
                        <field name="property_product_pricelist" readonly="1"/>
                    </xpath>
                </data>

            </field>
        </record>

        <record id="inherit_res_partner_form_view2" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view2</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_partner_property_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='title']" position="replace">
                        <label string="" colspan="2"/>
                    </xpath>

                    <xpath expr="//field[@name='supplier']" position="after">
                        <newline/>
                        <field name="active" select="2" />
                        <label string="" colspan="2"/>
                        <label string="" colspan="2"/>
                    </xpath>

                    <xpath expr="/form/notebook/page[@string='Sales &amp; Purchases']/field[@name='active']" position="replace">
                        <label string="" colspan="2"/>
                    </xpath>

                    <xpath expr="/form/notebook/page[@string='Accounting']/group" position="before">
                        <separator colspan="4" string="Informations comptables" />
                        <field name="siret" />
                        <field name="reglement" required="1" on_change="reglement_onchange(reglement)" />
                        <field name="facturation_bl" required="1" />
                        <field name="nb_ex_factures" />
                        <field name="releve" />
                        <field name="no_frais_de_port" />
                        <separator colspan="4" string="Informations ristourne" />
                        <field name="remise_fac" />
                        <field name="type_ristourne" />
                        <field name="taux_ristourne" />
                        <field name="total_ristourne" />
                    </xpath>
                </data>
            </field>
        </record>

        <record id="inherit_res_partner_form_view3" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view3</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page[@string='Sales &amp; Purchases']/field[@name='user_id']" position="after">
                        <field name="appeler_ok" />
                        <field name="tele_user_id" />
                    </xpath>
                    <xpath expr="/form/group" position="replace">
                        <group colspan="4" col="4">
                            <field name="name" select="1"/>
                            <field name="ref" select="1"/>
                            <field name="customer" select="1"/>
                            <field name="supplier" select="2"/>
                        </group>
                    </xpath>                    
                </data>
            </field>
        </record>

        <record id="inherit_res_partner_form_view4" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view4</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='General']/field[@name='address']/form/field[@name='email']" position="after">
                    <field name="pref_contact" />
                </xpath>
            </field>
        </record>

        <record id="inherit_res_partner_form_view5" model="ir.ui.view">
            <field name="name">inherit.res.partner.form.view5</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="iller_tournee.inherit_tournee_res_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Tournées']/field[@name='tournee3']" position="after">
                    <separator colspan="4" string="Autres informations" />
                    <field name="depose_ok" />
                    <newline />
                    <separator colspan="4" string="Commentaire Préparation" />
                    <field name="commentaire_prep" nolabel="1" colspan="4"/>
                    <newline />
                    <separator colspan="4" string="Commentaire Livraison" />
                    <field name="commentaire_livraison" nolabel="1" colspan="4"/>
                </xpath>
            </field>
        </record>

        <record id="inherit_res_partner_address_form_view1" model="ir.ui.view">
            <field name="name">inherit.res.partner.address.form.view1</field>
            <field name="model">res.partner.address</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_address_form1" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='email']" position="after">
                    <field name="pref_contact" />
                </xpath>
            </field>
        </record>
    <!-- Ajout du champ "code_saler" à la vue des utilisateurs -->
        <record id="inherit_res_users_form" model="ir.ui.view">
            <field name="name">inherit.res.partner.address.form.view1</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='login']" position="after">
                    <newline />
                    <field name="code_saler" />
                </xpath>
            </field>
        </record>

        <!-- suppression du champ 'Title' dans la vue liste -->
        <record id="inherit_del_title_view_partner_tree" model="ir.ui.view">
            <field name="name">inherit.del.title.view.partner.tree</field>
            <field name="model">res.partner</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="base.view_partner_tree" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/tree/field[@name='title']" position="replace" />
                    <xpath expr="/tree/field[@name='lang']" position="replace" />
                </data>
            </field>
        </record>
        
        <!-- Remodelage de la vue form des partenaires -->
        <record id="inherit_remod_view_partner_form" model="ir.ui.view">
            <field name="name">inherit.remod.view.partner.form</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page[@string='General']/field[@name='address']/form/field[@name='title']" position="replace" />
                    <xpath expr="/form/notebook/page[@string='General']/field[@name='address']/form/field[@name='function']" position="replace" />
                    <xpath expr="/form/notebook/page[@string='General']/field[@name='address']/form/field[@name='state_id']" position="replace" />
                    <xpath expr="/form/notebook//field[@name='website']" position="replace" />
                    <xpath expr="/form/notebook//field[@name='parent_id']" position="replace" />
                    <xpath expr="/form/notebook//field[@name='date']" position="replace" />
                    <xpath expr="/form/notebook/page[@string='History']" position="replace" />
                </data>
            </field>
        </record>
                
    </data>
</openerp>
