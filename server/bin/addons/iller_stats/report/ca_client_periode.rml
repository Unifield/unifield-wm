    <section>
      <para style="P6">[[repeatIn(getPartners(data['form']['partners']), 'p') ]]</para>
      <blockTable colWidths="59.0,230.0,28.0,32.0,32.0,32.0,32.0,34.0" style="Table4">
        <tr>
          <td>
