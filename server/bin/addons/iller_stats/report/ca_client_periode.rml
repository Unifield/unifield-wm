  <story>
    <para style="Standard">[[ repeatIn(objects, 'o') ]] [[ setLang('fr_FR') ]] </para>
    <para style="P1">EDITION C.A.A ET QUANTITES /REPR./CLIENT/PERIODE</para>
    <para style="P1">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="80.0,80.0,80.0,80.0,80.0,80.0" style="Table1">
      <tr>
        <td>
          <para style="P4">Période 1 :</para>
        </td>
        <td>
          <para style="P4">du [[ formatLang(o.date_depart_per1,date=True) ]] </para>
          <para style="P4">au [[ formatLang(o.date_fin_per1,date=True) ]]</para>
        </td>
        <td>
          <para style="P4">Période 2 : </para>
        </td>
        <td>
          <para style="P4">du [[ formatLang(o.date_depart_per2,date=True) ]] </para>
          <para style="P4">au [[ formatLang(o.date_fin_per2,date=True) ]]</para>
        </td>
        <td>
          <para style="P4">Période 3 : </para>
        </td>
        <td>
          <para style="P4">du [[ formatLang(o.date_depart_per3,date=True) ]] </para>
          <para style="P4">au [[ formatLang(o.date_fin_per3,date=True) ]]</para>
        </td>
      </tr>
    </blockTable>
    <para style="P2">
      <font color="white"> </font>
    </para>
    <para style="Standard">ÉDITÉ LE : [[ time.strftime('%d/%m/%Y') ]]</para>
    <para style="Standard">
      <font color="white"> </font>
    </para>
