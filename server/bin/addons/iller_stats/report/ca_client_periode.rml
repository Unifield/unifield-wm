  <story>
    <para style="Standard">[[ repeatIn(objects, 'o') ]] [[ setLang('fr_FR') ]] </para>
    <para style="Heading">EDITION C.A.A ET QUANTITES /REPR./CLIENT/PERIODE</para>
    <para style="P1">
      <font color="white"> </font>
    </para>
