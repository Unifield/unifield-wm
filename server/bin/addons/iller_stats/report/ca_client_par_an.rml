<?xml version="1.0"?>
<document filename="test.pdf">
    <template pageSize="(595.0,842.0)" title="Test" author="Martin Simon" allowSplitting="20">
        <pageTemplate id="footer">
            <pageGraphics>
                <setFont name="Helvetica" size="6"/>
                <fill color="black"/>
                <stroke color="black"/>
                <drawCentredString x="10.5cm" y="0.8cm">Page: <pageNumber/></drawCentredString>
            </pageGraphics>
            <frame x1="1.3cm" y1="2.5cm" height="750" width="480"/>
        </pageTemplate>
    <pageTemplate id="first">
      <frame id="first" x1="57.0" y1="57.0" width="481" height="770"/>
    </pageTemplate>
  </template>
  <stylesheet>
    <blockTableStyle id="Standard_Outline">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
  </blockTableStyle>
  <blockTableStyle id="Entete">
      <blockAlignment value="CENTER" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="OUTLINE" colorName="#000000" />
  </blockTableStyle>
  <blockTableStyle id="Infos">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="OUTLINE" colorName="#000000" />
  </blockTableStyle>
  <blockTableStyle id="Representant">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="OUTLINE" colorName="#000000" />
  </blockTableStyle>
  <blockTableStyle id="Partenaire">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1" />
      <lineStyle kind="LINEAFTER" colorName="#000000" start="-1,0" stop="-1,-1" />
  </blockTableStyle>
  <blockTableStyle id="Information">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1" />
      <lineStyle kind="LINEAFTER" colorName="#000000" start="-1,0" stop="-1,-1" />
      <lineStyle kind="LINEBELOW" colorName="#BBBBBB" start="0,-1" stop="-1,-1" />
  </blockTableStyle>
  <blockTableStyle id="Tot_Representant">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1" />
      <lineStyle kind="LINEAFTER" colorName="#000000" start="-1,0" stop="-1,-1" />
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="-1,-1" thickness="2" />
  </blockTableStyle>
  <blockTableStyle id="Tot_Information">
      <blockAlignment value="LEFT" />
      <blockValign value="MIDDLE" />
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1" />
      <lineStyle kind="LINEAFTER" colorName="#000000" start="-1,0" stop="-1,-1" />
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="-1,-1" thickness="2" />
  </blockTableStyle>
    <initialize>
      <paraStyle name="all" alignment="justify"/>
  </initialize>
    <paraStyle name="Standard" fontName="Helvetica" fontSize="6.0" leading="7" alignment="LEFT" />
    <paraStyle name="Entete1" fontName="Helvetica" fontSize="10.0" leading="12" alignment="CENTER" />
    <paraStyle name="Infos1" fontName="Helvetica" fontSize="6.0" leading="7" alignment="LEFT" />
    <paraStyle name="Infos_Gen" fontName="Helvetica-Bold" fontSize="8.0" leading="12" alignment="LEFT" />
    <paraStyle name="Infos" fontName="Helvetica" fontSize="6.0" leading="7" alignment="RIGHT" />
    <paraStyle name="Infos1_Right" fontName="Helvetica" fontSize="6.0" leading="7" alignment="RIGHT" />
    <images/>
  </stylesheet>
  <story>
    <para style="Standard">[[ setLang('fr_FR') ]][[ repeatIn(objects, 'o') ]]</para>

    <blockTable colWidths="540.0" style="Entete" keepWithNext="1">
        <tr>
            <td>
                <para style="Entete1">EDITION DU C.A ET QUANTITE /REPR/CLIENT/ANNEE</para>
            </td>
        </tr>
    </blockTable>

    <para style="Standard">
        <font color="white"> </font>
    </para>

    <blockTable colWidths="75.0,205.0,50.0,50.0,80.0,80.0" style="Infos" keepWithNext="1">
        <tr>
            <td>
                <para style="Infos1_Right">DU CLIENT : </para>
            </td>
            <td>
                <para style="Infos1">[[ '[%s] %s' % (o.depart_partner_id.ref, o.depart_partner_id.name) ]] </para>
            </td>
            <td>
                <para style="Infos1_Right">DE : </para>
            </td>
            <td>
                <para style="Infos1">[[ o.annee_depart ]]</para>
            </td>
            <td>
                <para style="Infos1_Right">DATE :</para>
            </td>
            <td>
                <para style="Infos1">[[ formatLang(time.strftime('%Y-%m-%d'), date=True) ]]</para>
            </td>
        </tr>
        <tr>
            <td>
                <para style="Infos1_Right">AU CLIENT : </para>
            </td>
            <td>
                <para style="Infos1">[[ '[%s] %s' % (o.fin_partner_id.ref, o.fin_partner_id.name) ]] </para>
            </td>
            <td>
                <para style="Infos1_Right">A : </para>
            </td>
            <td>
                <para style="Infos1">[[ o.annee_fin ]]</para>
            </td>
            <td>
                <para style="Infos1_Right">HEURE :</para>
            </td>
            <td>
                <para style="Infos1">[[ time.strftime('%H:%M:%S') ]]</para>
            </td>
        </tr>
    </blockTable>

    <para style="Standard">
        <font color="white"> </font>
    </para>

