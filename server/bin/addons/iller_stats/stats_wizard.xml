<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    <!-- Wizard pour le gibier -->
        <record id="wizard_gibier_view" model="ir.ui.view">
            <field name="name">wizard.gibier.view</field>
            <field name="model">wizard.gibier</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="État des entrées et sorties de gibier">
                    <field name="date_debut" />
                    <newline />
                    <field name="date_fin" />
                    <newline />
                    <field name="type" />
                    <newline />
                    <button string="Ok" name='action_confirmer' type="object" icon="gtk-apply" />
                    <button string="Annuler" special='cancel' icon='gtk-cancel' />
                </form>
            </field>
        </record>

    <!-- Wizard pour l'édition des articles par client -->
        <record id="wizard_articles_par_client_view" model="ir.ui.view">
            <field name="name">wizard.articles.par.client.view</field>
            <field name="model">wizard.articles.par.client</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Édition des articles par client">
                    <field name="partner_deb_id" domain="[('customer', '=', True)]"/>
                    <newline/>
                    <field name="partner_fin_id" domain="[('customer', '=', True)]"/>
                    <newline/>
                    <group colspan="4">
                        <label string="Du "/>
                        <field name="date_debut" nolabel="1"/>
                        <label string="au "/>
                        <field name="date_fin" nolabel="1"/>
                    </group>
                    <separator string="Options"/>
                    <newline />
                    <field name="est_decoupe"/>
                    <newline/>
                    <field name="famille_uniquement"/>
                    <newline/>
                    <field name="exclusion_magasin"/>
                    <newline/>
                    <separator string="   " />
                    <newline/>
                    <group colspan="4">
                        <button string="Ok" name='action_confirmer' type="object" icon="gtk-apply" />
                        <button string="Annuler" special='cancel' icon='gtk-cancel' />
                    </group>
                </form>
            </field>
        </record>

    <!-- Wizard pour le C.A par représentant et par an -->
        <record id="wizard_ca_par_representant_view" model="ir.ui.view">
            <field name="name">wizard.ca.par.representant.view</field>
            <field name="model">wizard.ca.par.representant</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="C.A / Poids par représentant et par an">
                    <field name="representant_deb_ref" colspan="4"/>
                    <newline />
                    <field name="representant_fin_ref" colspan="4"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="annee_debut" nolabel="1"/>
                        <label string="à : "/><field name="annee_fin" nolabel="1"/>
                    </group>
                    <separator string="Options"/>
                    <newline/>
                    <field name="tous_representants"/>
                    <newline />
                    <button string="Ok" name='action_confirmer' type="object" icon="gtk-apply" />
                    <button string="Annuler" special='cancel' icon='gtk-cancel' />
                </form>
            </field>
        </record>

    <!-- Wizard pour la quantité commandée par client et par article sur 5 périodes données -->
        <record id="wizard_qte_clt_cinq_periodes_view" model="ir.ui.view">
            <field name="name">wizard.qte.clt.cinq.periodes.view</field>
            <field name="model">wizard.qte.clt.cinq.periodes</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Quantité commandée par client et par article sur 5 périodes">
                    <field name="partner_deb_id" colspan="4"/>
                    <newline />
                    <field name="partner_fin_id" colspan="4"/>
                    <newline />
                    <separator string="Période 1"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut1" nolabel="1"/>
                        <label string="à : "/><field name="date_fin1" nolabel="1"/>
                    </group>
                    <newline />
                    <separator string="Période 2"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut2" nolabel="1"/>
                        <label string="à : "/><field name="date_fin2" nolabel="1"/>
                    </group>
                    <newline />
                    <separator string="Période 3"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut3" nolabel="1"/>
                        <label string="à : "/><field name="date_fin3" nolabel="1"/>
                    </group>
                    <newline />
                    <separator string="Période 4"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut4" nolabel="1"/>
                        <label string="à : "/><field name="date_fin4" nolabel="1"/>
                    </group>
                    <newline />
                    <separator string="Période 5"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut5" nolabel="1"/>
                        <label string="à : "/><field name="date_fin5" nolabel="1"/>
                    </group>
                    <newline />
                    <button string="Ok" name='action_confirmer' type="object" icon="gtk-apply" />
                    <button string="Annuler" special='cancel' icon='gtk-cancel' />
                </form>
            </field>
        </record>

    <!-- Wizard pour l'édition PAMP par client et par article sur une période donnée -->
        <record id="wizard_pamp_par_client_view" model="ir.ui.view">
            <field name="name">wizard.pamp.par.client.view</field>
            <field name="model">wizard.pamp.par.client</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Édition P.A.M.P par client et par article sur une période.">
                    <field name="partner_deb_id" colspan="4"/>
                    <newline />
                    <field name="partner_fin_id" colspan="4"/>
                    <newline />
                    <group colspan="4">
                        <label string="De : "/><field name="date_debut" nolabel="1"/>
                        <label string="à : "/><field name="date_fin" nolabel="1"/>
                    </group>
                    <newline />
                    <button string="Ok" name='action_confirmer' type="object" icon="gtk-apply" />
                    <button string="Annuler" special='cancel' icon='gtk-cancel' />
                </form>
            </field>
        </record>

    <!-- Actions -->
        <!-- Wizard pour obtenir l'état des entrées et sorties de gibier -->
        <act_window id="action_wizard_gibier"
            name="État des entrées et sorties de gibier"
            res_model="wizard.gibier"
            view_mode='form'
            view_type='form'
            target='new' />

        <!-- Wizard pour éditer les articles par client -->
        <act_window id="action_wizard_articles_par_client"
            name="Édition des articles par client"
            res_model="wizard.articles.par.client"
            view_mode='form'
            view_type='form'
            target='new' />

        <!-- Wizard pour éditer le C.A par représentant et par an -->
        <act_window id="action_wizard_ca_par_representant"
            name="Édition du C.A/POIDS par représentant et par an"
            res_model="wizard.ca.par.representant"
            view_mode='form'
            view_type='form'
            target='new' />

        <!-- Wizard pour éditer la quantité commandée par client et par article sur 5 périodes -->
        <act_window id="action_wizard_qte_clt_cinq_periodes"
            name="Quantité commandée par client et par article sur 5 périodes"
            res_model="wizard.qte.clt.cinq.periodes"
            view_mode='form'
            view_type='form'
            target='new' />

        <!-- Wizard pour l'édition PAMP par client et par article sur 1 période donnée -->
        <act_window id="action_wizard_pamp_par_client"
            name="P.A.M.P par client et par article sur une période donnée"
            res_model="wizard.pamp.par.client"
            view_mode='form'
            view_type='form'
            target='new' />

    <!-- Menus -->
        <menuitem id="menu_wizard_gibier"
                action="action_wizard_gibier"
                parent="stock.menu_stock_root" />

        <!-- Accès au wizard "Édition des articles par client" -->
        <menuitem id="menu_wizard_articles_par_client"
                action="action_wizard_articles_par_client"
                parent="base.menu_base_partner" />

        <!-- Accès au wizard "Édition des articles par client" -->
        <menuitem id="menu_wizard_ca_par_representant"
                action="action_wizard_ca_par_representant"
                parent="sale.menu_sale_root" />

        <!-- Accès au wizard "Édition des quantités commandées par client et par article sur 5 périodes" -->
        <menuitem id="menu_wizard_qte_clt_cinq_periodes"
                action="action_wizard_qte_clt_cinq_periodes"
                parent="sale.menu_sale_root" />

        <!-- Accès au wizard "Édition PAMP par client et par article pour une période donné" -->
        <menuitem id="menu_wizard_pamp_par_client"
                action="action_wizard_pamp_par_client"
                parent="sale.menu_sale_root" />
    </data>
</openerp>
