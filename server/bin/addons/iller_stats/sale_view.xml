<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

    <!-- Ajout de la tournée dans la recherche des commandes de vente -->
        <record id="tournee_sale_order_tree_view" model="ir.ui.view">
            <field name="name">tournee.sale.order.tree.view</field>
            <field name="model">sale.order</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="sale.view_order_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='tournee_id']" position="replace">
                    <field name="tournee_id" select="2"/>
                </xpath>
            </field>
        </record>

    </data>
</openerp>

