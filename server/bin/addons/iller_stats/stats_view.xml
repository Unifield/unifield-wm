<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    <!-- Vues -->
        <record id="gibier_entree_sortie_tree" model="ir.ui.view">
            <field name="name">gibier.entree.sortie.tree</field>
            <field name="model">gibier.entree.sortie</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="État des entrées et des sorties de gibier">
                    <field name="type"/>
                    <field name="date"/>
                    <field name="origine"/>
                    <field name="nom"/>
                    <field name="article"/>
                    <field name="designation"/>
                    <field name="qte"/>
                </tree>
            </field>
        </record>

        <record id="articles_par_client_tree" model="ir.ui.view">
            <field name="name">articles.par.client.tree</field>
            <field name="model">articles.par.client</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Édition des articles par client" colors="orange:est_total==True">
                    <field name="nom"/>
                    <field name="quantite"/>
                    <field name="ca_net"/>
                    <field name="prix_moyen"/>
                    <field name="remise"/>
                    <field name="est_total" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="edition_ca_par_representant_tree" model="ir.ui.view">
            <field name="name">edition.ca.par.representant.tree</field>
            <field name="model">edition.ca.par.representant</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Édition du C.A/POIDS par représentant et par an" colors="orange:designation[0]=='*'">
                    <field name="designation"/>
                    <field name="mois1"/>
                    <field name="mois2"/>
                    <field name="mois3"/>
                    <field name="mois4"/>
                    <field name="mois5"/>
                    <field name="mois6"/>
                    <field name="mois7"/>
                    <field name="mois8"/>
                    <field name="mois9"/>
                    <field name="mois10"/>
                    <field name="mois11"/>
                    <field name="mois12"/>
                    <field name="total"/>
                </tree>
            </field>
        </record>

        <record id="edition_qte_clt_cinq_periodes_tree" model="ir.ui.view">
            <field name="name">edition.qte.clt.cinq.periodes.tree</field>
            <field name="model">edition.qte.clt.cinq.periodes</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree colors="orange:est_client==True" string="Édition des quantités commandées par client et par article sur 5 périodes">
                    <field name="designation"/>
                    <field name="periode1"/>
                    <field name="periode2"/>
                    <field name="periode3"/>
                    <field name="periode4"/>
                    <field name="periode5"/>
                </tree>
            </field>
        </record>

        <record id="edition_pamp_par_client_tree" model="ir.ui.view">
            <field name="name">edition.pamp.par.client.tree</field>
            <field name="model">edition.pamp.par.client</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree colors="orange:est_client==True" string="Édition P.A.M.P. par client et par article sur une période donnée.">
                    <field name="designation"/>
                    <field name="quantite"/>
                    <field name="val_cons"/>
                    <field name="ca_ht"/>
                    <field name="marge"/>
                    <field name="marge_sur_ca"/>
                </tree>
            </field>
        </record>

    <!-- Vue pour le nombre de commandes par code regroupement (tournee) -->
        <record id="nbre_cmde_par_tournee_tree" model="ir.ui.view">
            <field name="name">nbre.cmde.par.tournee.tree</field>
            <field name="model">nbre.cmde.par.tournee</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Nombre de commandes par code regroupement (tournées)">
                    <field name="name" />
                    <field name="heure_depart" />
                    <field name="tot_non_validees" />
                    <field name="tot_facturees" />
                </tree>
            </field>
        </record>

    <!-- Actions -->
        <record id="action_nbre_cmde_par_tournee" model="ir.actions.act_window">
            <field name="name">Nombre de commandes par tournées</field>
            <field name="res_model">nbre.cmde.par.tournee</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="nbre_cmde_par_tournee_tree" />
        </record>

    <!-- Menus -->
        <menuitem action="action_nbre_cmde_par_tournee" 
            id="menu_action_nbre_cmde_par_tournee" 
            parent="sale.menu_sale_root"/>
    </data>
</openerp>
