<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="inherit_tournee_res_partner_form" model="ir.ui.view">
            <field name="name">inherit.tournee.partner.form</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Sales &amp; Purchases']" position="after">
                    <page string="Tournées">
                        <separator string="Tournées" colspan="4"/>
                        <field name="tournee1" attrs="{'required':[('customer','=',True)]}"/>
                        <field name="tournee2" />
                        <field name="tournee3" />
                        <newline />
                    </page>
                </xpath>
            </field>
        </record>

        <record id="tournee_form_view" model="ir.ui.view">
            <field name="name">tournee.form.view</field>
            <field name="model">tournee.iller</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Tournée">
                    <field name="name" select="1" />
                    <field name="heure_depart" select="1" />
                    <field name="regroup_code" />
                    <notebook colspan="4">
                        <page string="Clients">
                            <separator string="Postes" colspan="4" />
                            <field name="prep_id" />
                            <field name="decoupe_id" />
                            <separator string="Clients principaux" colspan="4" />
                            <field name="partner1" colspan="4" nolabel="1" />
                            <separator string="Clients secondaires" colspan="4" />
                            <field name="partner2" colspan="4" nolabel="1" />
                            <separator string="Clients exceptionnels" colspan="4" />
                            <field name="partner3" colspan="4" nolabel="1" />
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="tournee_tree_view" model="ir.ui.view">
            <field name="name">tournee.tree.view</field>
            <field name="model">tournee.iller</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Tournées">
                    <field name="name" />
                    <field name="heure_depart" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="wizard_commandes_par_tournee_form">
            <field name="name">wizard.commandes.par.tournee.form</field>
            <field name="model">commandes.par.tournee</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Commandes en cours par tournée/date">
                    <separator string="Commandes en cours par tournée et par date" />
                    <newline />
                    <field name="tournee_id" />
                    <newline />
                    <field name="date" />
                    <newline />
                    <button string="Ok" name='action_confirmer_liste_commandes' type="object" icon="gtk-apply" />
                    <button string="Annuler" special='cancel' icon='gtk-cancel' />
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="wizard_articles_par_tournee_form">
            <field name="name">wizard.articles.par.tournee.form</field>
            <field name="model">articles.par.tournee</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Articles par tournée/liste prépa.">
                    <separator string="Listes des articles par tournée" />
                    <newline />
                    <field name="tournee_id" />
                    <newline />
                    <field name="date" />
                    <newline />
                    <field name="type" />
                    <newline />
                    <group col="6" colspan="4">
                        <button string="Ok" name='action_confirmer_liste_articles' type="object" icon="gtk-apply" />
                        <button string="Annuler" special='cancel' icon='gtk-cancel' />
                        <button string="Imprimer un rapport" name="action_imprimer_rapport" type="object" icon="gtk-print" />
                    </group>
                </form>
            </field>
        </record>

        <record id="wizard_sale_order_line_form_view" model="ir.ui.view">
            <field name="name">wizard.sale.order.line.form.view</field>
            <field name="model">sale.order.line</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Sales order lines">
                    <field name="order_id"/>
                    <field name="order_partner_id"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="product_uom_qty" string="Qty"/>
                    <field name="product_uom" string="UoM"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="wizard_produits_a_expedier_par_tournee_form">
            <field name="name">wizard.produits.a.expedier.par.tournee.form</field>
            <field name="model">produits.a.expedier.par.tournee</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Produits à expédier par tournée">
                    <separator string="Produits à expédier par tournée" />
                    <newline />
                    <field name="tournee_id" />
                    <newline />
                    <field name="date" />
                    <newline />
                    <group col="6" colspan="4">
                        <button string="Ok" name='action_confirmer_tournee' type="object" icon="gtk-apply" />
                        <button string="Annuler" special='cancel' icon='gtk-cancel' />
                        <button string="Imprimer un rapport" name="action_imprimer_rapport" type="object" icon="gtk-print" />
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="wizard_produits_par_poste_form">
            <field name="name">wizard.produits.par.poste.form</field>
            <field name="model">produits.par.poste</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Produits par poste et par tournée">
                    <separator string="Produits par poste et par tournée" />
                    <newline />
                    <field name="poste_id" />
                    <newline />
                    <field name="date" />
                    <newline />
                    <field name="tournee_id" />
                    <newline />
                    <group col="6" colspan="4">
                        <button string="Ok" name='action_confirmer_poste' type="object" icon="gtk-apply" />
                        <button string="Annuler" special='cancel' icon='gtk-cancel' />
                    </group>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_tournee_form" model="ir.actions.act_window">
            <field name="name">Nouvelle tournée</field>
            <field name="res_model">tournee.iller</field>
            <field name="view_type">form</field>
            <field name="view_mode">form,tree</field>
        </record>

        <record id="action_tournee_tree" model="ir.actions.act_window">
            <field name="name">Toutes les tournées</field>
            <field name="res_model">tournee.iller</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_preparation_poste_tree" model="ir.actions.act_window">
            <field name="name">Tous les postes de préparation</field>
            <field name="res_model">iller.poste</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'PREP')]</field>
        </record>

        <record id="action_decoupe_poste_tree" model="ir.actions.act_window">
            <field name="name">Tous les postes de découpe</field>
            <field name="res_model">iller.poste</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'DECP'))</field>
        </record>

        <act_window id="action_commandes_par_tournee"
            name="Commandes en cours par tournée/date"
            res_model="commandes.par.tournee"
            src_model="tournee.iller"
            view_mode='form'
            view_type='form'
            target='new' />

        <act_window id="action_articles_par_tournee"
            name="Articles par tournée/liste prépa."
            res_model="articles.par.tournee"
            src_model="tournee.iller"
            view_mode='form'
            view_type='form'
            target='new' />

        <act_window id="action_produits_a_expedier_par_tournee"
            name="Produits à expédier par tournée"
            res_model="produits.a.expedier.par.tournee"
            src_model="tournee.iller"
            view_mode='form'
            view_type='form'
            context="{'sp_state': False}"
            target='new' />

        <act_window id="action_etat_produits_a_expedier_par_tournee"
            name="État des produits à expédier par tournée/date"
            res_model="produits.a.expedier.par.tournee"
            src_model="tournee.iller"
            view_mode='form'
            view_type='form'
            context="{'sp_state': True}"
            target='new' />

        <act_window id="action_produits_par_poste"
            name="Produits à expédier par poste/date/tournée"
            res_model="produits.par.poste"
            src_model="tournee.iller"
            view_mode='form'
            view_type='form'
            target='new' />

        <!-- Menus -->
        <menuitem id="menu_tournee_tree"
                  action="action_tournee_tree"
                  parent="base.menu_base_partner" />

        <menuitem id="menu_tournee_form"
                  action="action_tournee_form"
                  parent="menu_tournee_tree" />

        <menuitem id="menu_postes"
                  name="Tous les postes"
                  parent="base.menu_base_partner" />

        <menuitem id="menu_decoupe_tree"
                  action="action_decoupe_poste_tree"
                  parent="menu_postes" />

        <menuitem id="menu_preparation_tree"
                  action="action_preparation_poste_tree"
                  parent="menu_postes" />

        <menuitem id="menu_commandes_par_tournee"
                action="action_commandes_par_tournee"
                parent="base.menu_base_partner" />

        <menuitem id="menu_articles_par_tournee"
                action="action_articles_par_tournee"
                parent="base.menu_base_partner" />

        <menuitem id="menu_produits_a_expedier_par_tournee"
                action="action_produits_a_expedier_par_tournee"
                parent="stock.menu_stock_root" />

        <menuitem id="menu_etat_produits_a_expedier_par_tournee"
                action="action_etat_produits_a_expedier_par_tournee"
                parent="stock.menu_stock_root" />

        <menuitem id="menu_produits_par_poste"
                action="action_produits_par_poste"
                parent="stock.menu_stock_root" />

    </data>
</openerp>
