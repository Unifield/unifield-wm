<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>


        <!-- Ajout de la tournée sur la fiche de la commande -->
        <record id="tournee_sale_order_form_view" model="ir.ui.view">
            <field name="name">tournee.sale.order.form.view</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page/field[@name='partner_shipping_id']" position="replace">
                        <field name="partner_shipping_id" invisible="1" />
                        <field name="tournee_id" required="1" />
                    </xpath>
                </data>
            </field>
        </record>

        <record id="tournee_sale_order_tree_view" model="ir.ui.view">
            <field name="name">tournee.sale.order.tree.view</field>
            <field name="model">sale.order</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="sale.view_order_tree" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/tree/field[@name='partner_shipping_id']" position="replace">
                        <field name="tournee_id" />
                    </xpath>
                    <xpath expr="/tree/field[@name='tournee_id']" position="before">
                        <field name="contient_decoupe" select="1"/>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</openerp>

