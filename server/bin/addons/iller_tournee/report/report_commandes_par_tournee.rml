<?xml version="1.0"?>
<document filename="test.pdf">
  <template pageSize="(595.0,842.0)" title="Test" author="Martin Simon" allowSplitting="20">
    <pageTemplate id="first">
      <frame id="first" x1="14.0" y1="14.0" width="567" height="814"/>
    </pageTemplate>
  </template>
  <stylesheet>
    <blockTableStyle id="Standard_Outline">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau1">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEAFTER" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="0,0"/>
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="0,-1"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau2">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="GRID" colorName="#000000" start="0,0" stop="-1,0"/>
      <lineStyle kind="OUTLINE" colorName="black" start="0,0" stop="6,-1"/>
      <lineStyle kind="INNERGRID" colorName="gray" start="0,1" stop="6,-1" thickness="0.5"/>
      <blockBackground colorName="#e6e6e6" start="0,0" stop="-1,0"/>
    </blockTableStyle>
    <initialize>
      <paraStyle name="all" alignment="justify"/>
    </initialize>
    <paraStyle name="P1" fontName="Times-Bold" fontSize="16.0" leading="20" alignment="CENTER" backColor="#e6e6e6"/>
    <paraStyle name="P2" fontName="Times-Roman" fontSize="10.0" leading="13"/>
    <paraStyle name="P3" fontName="Times-Roman" fontSize="10.0" leading="10" alignment="CENTER"/>
    <paraStyle name="P4" fontName="Times-Roman" fontSize="11.0" leading="14"/>
    <paraStyle name="P5" rightIndent="0.0" leftIndent="35.0" fontName="Times-Roman" fontSize="10.0" leading="13"/>
    <paraStyle name="P6" fontName="Times-Roman" fontSize="10.0" leading="10"/>
    <paraStyle name="P7" fontName="Times-Roman" fontSize="10.0" leading="13" alignment="CENTER"/>
    <paraStyle name="P8" fontName="Times-Roman" fontSize="10.0" leading="10" alignment="RIGHT"/>
    <paraStyle name="Standard" fontName="Times-Roman"/>
    <paraStyle name="Heading" fontName="Helvetica" fontSize="14.0" leading="17" spaceBefore="12.0" spaceAfter="6.0"/>
    <paraStyle name="Text body" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="List" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="Caption" fontName="Times-Roman" fontSize="12.0" leading="15" spaceBefore="6.0" spaceAfter="6.0"/>
    <paraStyle name="Index" fontName="Times-Roman"/>
    <paraStyle name="Table Contents" fontName="Times-Roman"/>
    <paraStyle name="Table Heading" fontName="Times-Roman" alignment="CENTER"/>
    <images/>
  </stylesheet>
  <story>
    <para style="P4">[[ setLang('fr_FR') ]]</para>
    <para style="P2">[[ repeatIn(objects, 'o') ]]</para>
    <blockTable colWidths="567.0" style="Tableau1">
      <tr>
        <td>
          <para style="P1">Tournée : [[ o.tournee_id.name ]]</para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <para style="Standard">Client : [[ o.partner_shipping_id.partner_id.name ]]</para>
    <para style="P2">Adresse : </para>
    <para style="P5">[[ o.partner_shipping_id.name ]]</para>
    <para style="P5">[[ o.partner_shipping_id.street ]]</para>
    <para style="P5">[[ o.partner_shipping_id.zip ]] [[ o.partner_shipping_id.city ]]</para>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <para style="P2">N° commande : [[ o.name ]]</para>
    <para style="P2">
      <font color="white"> </font>
    </para>
    <section>
      <blockTable colWidths="37.0,152.0,33.0,34.0,81.0,41.0,189.0" style="Tableau2">
        <tr>
          <td>
            <para style="P7">Code</para>
          </td>
          <td>
            <para style="P7">Nom</para>
          </td>
          <td>
            <para style="P7">Qté</para>
          </td>
          <td>
            <para style="P7">UdM</para>
          </td>
          <td>
            <para style="P7">Lot</para>
          </td>
          <td>
            <para style="P7">Qté eff.</para>
          </td>
          <td>
            <para style="P7">Remarques</para>
          </td>
        </tr>
        <tr>
          <td>
            <para style="P3">[[ repeatIn(getProducts(o), 'p') ]]</para>
            <para style="P3">[[ p.product_id.default_code ]]</para>
          </td>
          <td>
            <para style="P6">[[ p.product_id.name ]]</para>
          </td>
          <td>
            <para style="P8">[[ locale.format('%.2f', p.product_uom_qty, False) ]]</para>
          </td>
          <td>
            <para style="P8">[[ p.product_uom.name ]]</para>
          </td>
          <td>
            <para style="P6">
              <font color="white"> </font>
            </para>
          </td>
          <td>
            <para style="P6">
              <font color="white"> </font>
            </para>
          </td>
          <td>
            <para style="P6">
              <font color="white"> </font>
            </para>
          </td>
        </tr>
      </blockTable>
      <para style="P2">
        <font color="white"> </font>
      </para>
      <para style="P2">
        <font color="white"> </font>
      </para>
    </section>
    <para style="P2">
      <font color="white"> </font>
    </para>
  </story>
</document>

