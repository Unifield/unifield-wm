<?xml version="1.0"?>
<document filename="test.pdf">
  <template pageSize="(595.0,842.0)" title="Test" author="Martin Simon" allowSplitting="20">
    <pageTemplate id="first">
      <frame id="first" x1="14.0" y1="14.0" width="567" height="814"/>
    </pageTemplate>
  </template>
  <stylesheet>
    <blockTableStyle id="Standard_Outline">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau1">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEAFTER" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="0,0"/>
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="0,-1"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau2">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEAFTER" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="0,0"/>
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="0,-1"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau3">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="GRID" colorName="#000000" start="0,0" stop="-1,0"/>
      <lineStyle kind="OUTLINE" colorName="black" start="0,0" stop="6,-1"/>
      <lineStyle kind="INNERGRID" colorName="gray" start="0,1" stop="6,-1" thickness="0.5"/>
      <blockBackground colorName="#e6e6e6" start="0,0" stop="-1,0"/>
    </blockTableStyle>
    <initialize>
      <paraStyle name="all" alignment="justify"/>
    </initialize>
    <paraStyle name="P1" fontName="Times-Roman" alignment="CENTER" backColor="#e6e6e6"/>
    <paraStyle name="P2" fontName="Times-Bold" fontSize="16.0" leading="20" alignment="CENTER" backColor="#e6e6e6"/>
    <paraStyle name="P3" fontName="Times-Roman" alignment="RIGHT"/>
    <paraStyle name="P4" fontName="Times-Roman" alignment="CENTER"/>
    <paraStyle name="P5" fontName="Times-Roman" alignment="CENTER"/>
    <paraStyle name="Standard" fontName="Times-Roman"/>
    <paraStyle name="Heading" fontName="Helvetica" fontSize="14.0" leading="17" spaceBefore="12.0" spaceAfter="6.0"/>
    <paraStyle name="Text body" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="List" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="Caption" fontName="Times-Roman" fontSize="12.0" leading="15" spaceBefore="6.0" spaceAfter="6.0"/>
    <paraStyle name="Index" fontName="Times-Roman"/>
    <paraStyle name="Table Contents" fontName="Times-Roman"/>
    <images/>
  </stylesheet>
  <story>
    <para style="Text body">[[ setLang('fr_FR') ]]</para>
    <blockTable colWidths="567.0" style="Tableau1">
      <tr>
        <td>
          <para style="P2">Tournée : <font face="Times-Roman">[[ data['form']['tournee_id'][1] ]]</font></para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <section>
      <para style="Standard">[[ repeatIn(getSaleOrderLineByType(data['form']['tournee_id'][0], data['form']['date'], data['form']['type']), 'solbt') ]]</para>
      <blockTable colWidths="567.0" style="Tableau2">
        <tr>
          <td>
            <para style="P1">[[ getType(solbt) or False ]]</para>
          </td>
        </tr>
      </blockTable>
      <para style="Standard">
        <font color="white"> </font>
      </para>
      <blockTable colWidths="35.0,155.0,36.0,231.0,31.0,33.0,47.0" style="Tableau3">
        <tr>
          <td>
            <para style="Table Contents">Réf. </para>
          </td>
          <td>
            <para style="Table Contents">Client</para>
          </td>
          <td>
            <para style="Table Contents">Code</para>
          </td>
          <td>
            <para style="Table Contents">Produit</para>
          </td>
          <td>
            <para style="Table Contents">Qté</para>
          </td>
          <td>
            <para style="Table Contents">UdM</para>
          </td>
          <td>
            <para style="Table Contents">État</para>
          </td>
        </tr>
        <tr>
          <td>
            <para style="P4">[[ repeatIn(solbt, 'sol') ]]</para>
            <para style="P4">[[ sol.order_id.name ]]</para>
          </td>
          <td>
            <para style="Table Contents">[[ sol.order_id.partner_id.name ]]</para>
          </td>
          <td>
            <para style="P4">[[ sol.product_id.default_code ]]</para>
          </td>
          <td>
            <para style="Table Contents">[[ sol.product_id.name ]]</para>
          </td>
          <td>
            <para style="P3">[[ formatLang(sol.product_uom_qty) ]]</para>
          </td>
          <td>
            <para style="P3">[[ sol.product_uom.name ]]</para>
          </td>
          <td>
            <para style="P4">[[ getSelection(sol, 'state') ]]</para>
          </td>
        </tr>
      </blockTable>
      <para style="Standard">
        <font color="white"> </font>
      </para>
    </section>
    <para style="Standard">
      <font color="white"> </font>
    </para>
  </story>
</document>

