<?xml version="1.0" encoding="utf-8" ?>
<openerp>
	<data>


        <!-- Ajout d'une tournée sur la vue des picking -->
        <record id="tournee_stock_picking_form_view" model="ir.ui.view">
            <field name="name">tournee.stock.picking.form.view</field>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_picking_out_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='address_id']" position="replace">
                    <field name="tournee_id" select="1" required="1" />
                </xpath>
            </field>
        </record>

        <record id="tournee_stock_picking_tree_view" model="ir.ui.view">
            <field name="name">tournee.stock.picking.tree.view</field>
            <field name="model">stock.picking</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/group/field[@name='address_id']" position="after">
                    <field name="tournee_id" required="1" />
                </xpath>
            </field>
        </record>

        <!-- Ajout d'un poste de préparation sur les lignes de mouvements des 
             picking -->
        <record id="tournee_stock_move_tree_view" model="ir.ui.view">
          <field name="name">tournee.stock.move.tree.view</field>
          <field name="model">stock.move</field>
          <field name="type">tree</field>
          <field name="inherit_id" ref="stock.view_move_tree" />
          <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='product_uom']" position="after">
                <field name="poste_id" />
            </xpath>
          </field>
        </record>

        <record id="tournee_view_picking_out_form" model="ir.ui.view">
            <field name="name">tournee.view.picking.out.form.view</field>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
              <xpath expr="/form/notebook/page/field[@name='move_lines']/form/field[@name='date_planned']" position="after">
                    <field name="poste_id" />
                </xpath>
            </field>
        </record>




	</data>
</openerp>

