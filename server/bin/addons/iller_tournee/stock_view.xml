<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>
        <!-- Ajout d'une tournée sur la vue des picking -->
        <record id="tournee_stock_picking_form_view" model="ir.ui.view">
            <field name="name">tournee.stock.picking.form.view</field>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_picking_out_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='address_id']" position="after">
                    <field name="tournee_id" select="1" required="1" />
                </xpath>

            </field>
        </record>

        <record id="iller_stock_form_view" model="ir.ui.view">
            <field name="name">iller.stock.form.view</field>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="priority" eval="16" />
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='address_id']" position="replace">
                        <field name="address_id" on_change="onchange_partner_id(address_id)" required="1" select="1"/>
                    </xpath>
                    <xpath expr="//field[@name='type']" position="after">
                        <field name="code"/>
                    </xpath>
                    <xpath expr="//field[@name='origin']" position="after">
                        <field name="include_port"/>
                        <field name="nb_elts"/>
                        <field name="num_preparateur"/>
                        <field name="bac_qty"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="tournee_stock_picking_tree_view" model="ir.ui.view">
            <field name="name">tournee.stock.picking.tree.view</field>
            <field name="model">stock.picking</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/group/field[@name='address_id']" position="after">
                    <field name="tournee_id" required="1" />
                </xpath>
            </field>
        </record>

        <!-- Ajout d'un poste de préparation sur les lignes de mouvements des 
             picking -->
        <record id="tournee_stock_move_tree_view" model="ir.ui.view">
          <field name="name">tournee.stock.move.tree.view</field>
          <field name="model">stock.move</field>
          <field name="type">tree</field>
          <field name="inherit_id" ref="stock.view_move_tree" />
          <field name="arch" type="xml">
            <xpath expr="/tree" position="replace">
                <tree colors="grey:state=='cancel';green:state=='draft';orange:state=='assigned';yellow:state=='waiting';red:state=='confirmed'" string="Moves" editable="top">
                    <!--<field name="name"/>-->
                    <field name="product_id"/>
<!--
                    <field name="prodlot_id"/>
-->
                    <field name="num_lot"/>
                    <field name="product_qty" on_change="onchange_quantity(product_id, product_qty, product_uom, product_uos)"/>
                    <field name="product_uom" string="UOM" readonly="1" />
                    <field name="reliquat" />
                    <field name="poste_id" readonly="1" />
                    <field name="picking_id" select="1" invisible="1" />

                    <field name="location_id" invisible="1" />
                    <field name="location_dest_id" invisible="1" />
                    <field name="date_planned" invisible="1" />
                    <field name="state" invisible="1" />
                </tree>
            </xpath>
          </field>
        </record>

        <record id="tournee_view_picking_out_form" model="ir.ui.view">
            <field name="name">tournee.view.picking.out.form.view</field>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page/field[@name='move_lines']/form/field[@name='date_planned']" position="after">
                        <field name="poste_id" />
                    </xpath>
                    <xpath expr="/form/notebook/page/field[@name='move_lines']/form/field[@name='prodlot_id']" position="replace">
                        <field name="num_lot" />
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</openerp>

