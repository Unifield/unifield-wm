<?xml version="1.0"?>
<openerp>
    <data>

        <record id="iller_invoice_view_form" model="ir.ui.view">
            <field name="name">iller.invoice.view.form</field>
            <field name="model">account.invoice</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.invoice_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//group/group" position="after" >
                        <field name="code" string="Code client" />
                    </xpath>
                    <xpath expr="/form/notebook/page/field[@name='invoice_line']" position="replace" >
                        <field colspan="4" name="invoice_line" nolabel="1" widget="one2many_list" height="250"/>
                    </xpath>
                </data>
            </field>
        </record>
        
    </data>
</openerp>
