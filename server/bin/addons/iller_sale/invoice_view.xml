<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="depassement_res_partner_form_view1" model="ir.ui.view">
            <field name="name">depassement.res.partner.form.view1</field>
            <field name="model">account.invoice</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.invoice_form" />
            <field name="arch" type="xml">
                <data>
                
                    <xpath expr="/form/notebook/page[@string='Other Info']/field[@name='date_due']" position="before" >
                        <field name="user_id" />
                    </xpath>
                </data>
                
            </field>
        </record>

        <record id="iller_view_move_form" model="ir.ui.view">
            <field name="name">iller.view.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="type">form</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//form/field/form/field[@name='state']" position="after" >
                        <field name="exported_csv" string="Ligne exportée ?" />
                    </xpath>
                    <xpath expr="//form/field/tree/field[@name='state']" position="after" >
                        <field name="exported_csv" string="Ligne exportée ?" />
                    </xpath>
                </data>
            </field>
        </record>
        
        <record id="iller_view_move_line_tree" model="ir.ui.view">
            <field name="name">iller.view.move.line.tree</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree" />
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree/field[@name='state']" position="after" >
                        <field name="exported_csv" string="Ligne exportée ?" />
                    </xpath>
                </data>
            </field>
        </record>
        
        <record id="iller_view_move_line_form" model="ir.ui.view">
            <field name="name">iller.view.move.line.form</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form" />
            <field name="type">form</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//form/notebook/page/field[@name='state']" position="after" >
                        <field name="exported_csv" string="Ligne exportée ?" />
                    </xpath>
                </data>
            </field>
        </record>
        
        <record id="iller_view_move_line_form2" model="ir.ui.view">
            <field name="name">iller.view.move.line.form2</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form2" />
            <field name="type">form</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//form/notebook/page/field[@name='state']" position="after" >
                        <field name="exported_csv" string="Ligne exportée ?" />
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</openerp>
