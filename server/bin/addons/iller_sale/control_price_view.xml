<?xml version="1.0" encoding="utf-8" ?>
<openerp>
	<data>

        <record id="iller_control_price_view_order_form" model="ir.ui.view">
            <field name="name">iller.control.price.view.order.form</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page/field[@name='order_line']/form/notebook/page/field[@name='price_unit']" position="replace">
                        <field name="price_unit" select="2" on_change="price_unit_change(price_unit, product_id, product_uom_qty, parent.partner_id, parent.pricelist_id)" />
                    </xpath>
                </data>
            </field>
        </record>

        <!-- Ajout du champ 'dépassement' dans la vue du partenaire -->
        <record id="depassement_res_partner_form_view1" model="ir.ui.view">
            <field name="name">depassement.res.partner.form.view1</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="iller_partner.inherit_res_partner_form_view2" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Accounting']/field[@name='bloque']" position="after" >
                    <field name="depassement" />
                </xpath>
            </field>
        </record>

	</data>
</openerp>

