<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <!-- Ajout de la coche "Dépassement autorisé" sur le produit -->
        <record id="inherit_product_normal_form_view_depassement" model="ir.ui.view">
            <field name="name">inherit.product.normal.form.view.depassement</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='rental']" position="after">
                    <field groups="iller_sale.group_depassement" name="depassement_autorise"/>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
