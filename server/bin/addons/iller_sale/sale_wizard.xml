<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

    <!-- Wizard : Marge par articles ou catégories d'articles -->
        <record model="ir.ui.view" id="wizard_marges_articles">
            <field name="name">wizard.marges.articles.form</field>
            <field name="model">wizard.marges.articles</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Marges par article ou famille d'articles">
                    <separator string="Marges par article ou famille d'articles" />
                    <newline />
                    <field name="date_debut"/>
                    <newline />
                    <field name="date_fin"/>
                    <newline />
                    <field name="article"/>
                    <newline />
                    <field name="famille_article"/>
                    <newline />
                    <group col="6" colspan="4">
                        <button string="Imprimer un rapport" name='action_imprimer_rapport' type="object" icon="gtk-print" />
                        <button string="Annuler" special='cancel' icon='gtk-cancel' />
                    </group>
                </form>
            </field>
        </record>

    <!-- Actions -->
        <act_window id="action_marges_articles"
            name="Marges par article ou famille d'articles"
            res_model="wizard.marges.articles"
            view_mode='form'
            view_type='form'
            target='new' />

    <!-- Menu pour accès au wizard "marges par articles ou catégories d'articles" -->
        <menuitem id="menu_marges_articles"
                action="action_marges_articles"
                parent="base.menu_base_partner" />

    </data>
</openerp>
