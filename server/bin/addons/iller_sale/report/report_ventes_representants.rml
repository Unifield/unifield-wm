<?xml version="1.0"?>
<document filename="test.pdf">
  <template pageSize="(595.0,842.0)" title="Test" author="Martin Simon" allowSplitting="20">
    <pageTemplate id="first">
      <frame id="first" x1="57.0" y1="57.0" width="481" height="728"/>
    </pageTemplate>
  </template>
  <stylesheet>
    <blockTableStyle id="Standard_Outline">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau1">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEAFTER" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="0,0"/>
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="0,-1"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau2">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="GRID" colorName="#000000" start="0,0" stop="-1,0"/>
      <lineStyle kind="OUTLINE" colorName="black" start="0,0" stop="2,-1"/>
      <lineStyle kind="INNERGRID" colorName="gray" start="0,1" stop="2,-1" thickness="0.5"/>
      <blockBackground colorName="#e6e6e6" start="0,0" stop="-1,0"/>
    </blockTableStyle>
    <initialize>
      <paraStyle name="all" alignment="justify"/>
    </initialize>
    <paraStyle name="P1" fontName="Times-Roman"/>
    <paraStyle name="P2" fontName="Times-Roman" fontSize="10.0" leading="13" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="P3" fontName="Times-Roman" alignment="CENTER"/>
    <paraStyle name="P4" fontName="Times-Roman" alignment="RIGHT" fontSize="10.0" leading="10"/>
    <paraStyle name="P5" fontName="Times-Roman" fontSize="16.0" leading="20" alignment="CENTER" backColor="#e6e6e6"/>
    <paraStyle name="Standard" fontName="Times-Roman" fontSize="10.0" leading="10"/>
    <paraStyle name="Heading" fontName="Helvetica" fontSize="14.0" leading="17" spaceBefore="12.0" spaceAfter="6.0"/>
    <paraStyle name="Text body" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="List" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="Caption" fontName="Times-Roman" fontSize="12.0" leading="15" spaceBefore="6.0" spaceAfter="6.0"/>
    <paraStyle name="Index" fontName="Times-Roman"/>
    <paraStyle name="Table Contents" fontName="Times-Roman"/>
    <images/>
  </stylesheet>
  <story>
    <para style="P2">[[ setLang('fr_FR') ]]</para>
    <blockTable colWidths="482.0" style="Tableau1">
      <tr>
        <td>
          <para style="P5">Ventes par représentant</para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <para style="P1">Période du : [[ data['form']['date_debut'] ]]</para>
    <para style="P1">au : [[ data['form']['date_fin'] ]]</para>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <para style="Standard">[[ repeatIn(getRepresentants(data['form']['representant']), 'repr') ]]</para>
    <section>
      <para style="Standard">[[ repr.name ]]</para>
    </section>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="339.0,72.0,72.0" style="Tableau2">
      <tr>
        <td>
          <para style="Table Contents">Représentant</para>
        </td>
        <td>
          <para style="P3">Nombre de commandes</para>
        </td>
        <td>
          <para style="P3">Total des ventes</para>
        </td>
      </tr>
      <tr>
        <td>
          <para style="Standard">[[ repeatIn(getRepresentants(data['form']['representant']), 'repr') ]]</para>
          <para style="Standard">[[ repr.name ]]</para>
        </td>
        <td>
          <para style="P4">[[ getNbreCmdes(repr.id, data['form']['date_debut'], data['form']['date_fin']) ]]</para>
        </td>
        <td>
          <para style="P4">[[ getTotalVentes(repr.id, data['form']['date_debut'], data['form']['date_fin']) ]]</para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
  </story>
</document>

