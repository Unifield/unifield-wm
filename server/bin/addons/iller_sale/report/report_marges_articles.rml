<?xml version="1.0"?>
<document filename="test.pdf">
  <template pageSize="(595.0,842.0)" title="Test" author="Martin Simon" allowSplitting="20">
    <pageTemplate id="first">
      <frame id="first" x1="14.0" y1="14.0" width="567" height="814"/>
    </pageTemplate>
  </template>
  <stylesheet>
    <blockTableStyle id="Standard_Outline">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau1">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="LINEBEFORE" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEAFTER" colorName="#000000" start="0,0" stop="0,-1"/>
      <lineStyle kind="LINEABOVE" colorName="#000000" start="0,0" stop="0,0"/>
      <lineStyle kind="LINEBELOW" colorName="#000000" start="0,-1" stop="0,-1"/>
    </blockTableStyle>
    <blockTableStyle id="Tableau2">
      <blockAlignment value="LEFT"/>
      <blockValign value="TOP"/>
      <lineStyle kind="GRID" colorName="#000000" start="0,0" stop="-1,0"/>
      <lineStyle kind="OUTLINE" colorName="black" start="0,0" stop="4,-1"/>
      <lineStyle kind="INNERGRID" colorName="gray" start="0,1" stop="4,-1" thickness="0.5"/>
      <blockBackground colorName="#e6e6e6" start="0,0" stop="-1,0"/>
    </blockTableStyle>
    <initialize>
      <paraStyle name="all" alignment="justify"/>
    </initialize>
    <paraStyle name="P1" fontName="Times-Bold" fontSize="16.0" leading="20" alignment="CENTER" backColor="#e6e6e6"/>
    <paraStyle name="P2" fontName="Times-Roman"/>
    <paraStyle name="P3" fontName="Times-Roman" fontSize="10.0" leading="13"/>
    <paraStyle name="P4" fontName="Times-Roman" fontSize="10.0" leading="13" alignment="RIGHT"/>
    <paraStyle name="P5" fontName="Times-Roman" fontSize="10.0" leading="13" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="P6" fontName="Times-Roman" fontSize="10.0" leading="13" alignment="RIGHT"/>
    <paraStyle name="P7" fontName="Times-Roman" fontSize="10.0" leading="10" alignment="CENTER"/>
    <paraStyle name="Standard" fontName="Times-Roman"/>
    <paraStyle name="Heading" fontName="Helvetica" fontSize="14.0" leading="17" spaceBefore="12.0" spaceAfter="6.0"/>
    <paraStyle name="Text body" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="List" fontName="Times-Roman" spaceBefore="0.0" spaceAfter="6.0"/>
    <paraStyle name="Caption" fontName="Times-Roman" fontSize="12.0" leading="15" spaceBefore="6.0" spaceAfter="6.0"/>
    <paraStyle name="Index" fontName="Times-Roman"/>
    <paraStyle name="Table Contents" fontName="Times-Roman"/>
    <images/>
  </stylesheet>
  <story>
    <para style="P5">[[ setLang('fr_FR') ]]</para>
    <blockTable colWidths="567.0" style="Tableau1">
      <tr>
        <td>
          <para style="P1">Marges du [[ data['form']['date_debut'] ]] au [[ data['form']['date_fin'] ]]</para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <para style="P2">Catégorie : [[ getCateg(data['form']['article'], data['form']['famille_article']) ]]</para>
    <para style="Standard">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="71.0,361.0,45.0,45.0,45.0" style="Tableau2">
      <tr>
        <td>
          <para style="P7">Code Article</para>
        </td>
        <td>
          <para style="P7">Dénomination</para>
        </td>
        <td>
          <para style="P7">Prix d'achat</para>
        </td>
        <td>
          <para style="P7">Articles vendus</para>
        </td>
        <td>
          <para style="P7">Marge moyenne (%)</para>
        </td>
      </tr>
      <tr>
        <td>
          <para style="P3">[[ repeatIn(getElements(data['form']['article'], data['form']['famille_article']), 'el') ]] [[ el.default_code ]]</para>
        </td>
        <td>
          <para style="P3">[[ el.name ]]</para>
        </td>
        <td>
          <para style="P6">[[ locale.format('%.2f', getPrixHA(el.id, data['form']['date_debut'], data['form']['date_fin']), False) ]]</para>
        </td>
        <td>
          <para style="P6">[[ locale.format('%.2f', getQteArticles(el.id, data['form']['date_debut'], data['form']['date_fin']), False) ]]</para>
        </td>
        <td>
          <para style="P4">[[ getMarge(el.id, data['form']['date_debut'], data['form']['date_fin']) ]]</para>
        </td>
      </tr>
    </blockTable>
    <para style="Standard">
      <font color="white"> </font>
    </para>
  </story>
</document>

