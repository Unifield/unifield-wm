<?xml version="1.0" encoding="utf-8" ?>
<openerp>
	<data>

        <!-- Ajout du taux de commission sur les vues des barèmes -->
        <record id="iller_commission_bareme_form_view" model="ir.ui.view">
            <field name="name">iller.commission.bareme.form.view</field>
            <field name="model">product.pricelist.bareme</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="iller_product.product_pricelist_bareme_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='valeur']" position="after">
                    <field name="taux_com" required="1" />
                </xpath>
            </field>
        </record>


        <record id="iller_commission_bareme_tree_view" model="ir.ui.view">
            <field name="name">iller.commission.bareme.tree.view</field>
            <field name="model">product.pricelist.bareme</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="iller_product.product_pricelist_bareme_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='valeur']" position="after">
                    <field name="taux_com" required="1" />
                </xpath>
            </field>
        </record>


        <!-- Ajout du montant des commissions sur les lignes de ventes et les bons de commande -->
        <record id="iller_commission_view_order_line_tree" model="ir.ui.view">
            <field name="name">iller.commission.view.order.line.tree</field>
            <field name="model">sale.order.line</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="sale.view_order_line_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='price_subtotal']" position="after">
                    <field name="commission" />
                </xpath>
            </field>
        </record>

        <record id="iller_commission_view_order_line_form2" model="ir.ui.view">
            <field name="name">iller.commission.view.order.line.form2</field>
            <field name="model">sale.order.line</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_line_form2" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page/field[@name='price_subtotal']" position="after">
                    <field name="commission" />
                </xpath>
            </field>
        </record>

        <record id="iller_commission_view_order_form" model="ir.ui.view">
            <field name="name">iller.commission.view.order.form</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page/field[@name='order_line']/form/notebook/page/field[@name='delay']" position="after">
                        <field name="commission" />
                    </xpath>
                    <xpath expr="/form/notebook/page/group/field[@name='amount_total']" position="after">
                        <field name="commission" />
                    </xpath>
                </data>
            </field>
        </record>

        <!-- Ajout du champ 'dépassement' dans la vue du partenaire -->
        <record id="depassement_res_partner_form_view1" model="ir.ui.view">
            <field name="name">depassement.res.partner.form.view1</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="iller_partner.inherit_res_partner_form_view2" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Accounting']/field[@name='bloque']" position="after" >
                    <field name="depassement" />
                </xpath>
            </field>
        </record>

	</data>
</openerp>

