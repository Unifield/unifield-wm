<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="inherit_product_pricelist_item_form_view1" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.item.form1</field>
            <field name="model">product.pricelist.item</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/group" position="replace">
                    <field name="bareme_id" on_change="bareme_change(bareme_id,base)" />
                    <label string="Indication de la valeur" />
                    <field name="price_discount" nolabel="1" readonly="1" />
                    <separator colspan="4" string="Tarif spécial client"/>
                    <field name="price_surcharge" string="Prix Special"/>
                </xpath>
            </field>
        </record>

        <record id="inherit_product_pricelist_item_tree_view1" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.tree.form1</field>
            <field name="model">product.pricelist.item</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_item_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='categ_id']" position="after">
                    <field name="bareme_id" />
                </xpath>
            </field>
        </record>

        <record id="product_pricelist_bareme_form_view" model="ir.ui.view">
            <field name="name">product.pricelist.bareme.form.view</field>
            <field name="model">product.pricelist.bareme</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Barème">
                    <field name="name" required="1" select="1" />
                    <field name="valeur" required="1" select="2" />
                    <field name="special" />
                    <field name="bareme_matrice_ids" colspan="4" mode="tree,form" nolabel="1" widget="one2many_list" default_get="{'bareme_id': name}">
                        <tree string="Lignes de matrice" editable="top">
                            <field name="prix_produit" />
                            <field name="valeur" />
                        </tree>
                    </field>
                </form>
            </field>
        </record>

        <record id="product_pricelist_bareme_tree_view" model="ir.ui.view">
            <field name="name">product.pricelist.bareme.tree.view</field>
            <field name="model">product.pricelist.bareme</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Barèmes">
                    <field name="name" select="1" />
                    <field name="valeur" select="1" />
                </tree>
            </field>
        </record>

        <record id="action_product_pricelist_bareme_tree" model="ir.actions.act_window">
            <field name="name">Tous les barèmes</field>
            <field name="res_model">product.pricelist.bareme</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_product_pricelist_bareme"
                  action="action_product_pricelist_bareme_tree"
                  parent="product.menu_price" />

        <!-- Configuration matrice des prix -->
        <record id="matrice_configuration_form_view" model="ir.ui.view">
            <field name="name">matrice.configuration.form.view</field>
            <field name="model">product.bareme.matrice</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Configuration de la matrice des prix">
                    <field name="bareme_id"/>
                    <field name="prix_produit" />
                    <field name="valeur" />
                </form>
            </field>
        </record>

        <record id="matrice_configuration_tree_view" model="ir.ui.view">
            <field name="name">matrice.configuration.tree.view</field>
            <field name="model">product.bareme.matrice</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Configuration de la matrice des prix">
                    <field name="bareme_id"/>
                    <field name="prix_produit" />
                    <field name="valeur" />
                </tree>
            </field>
        </record>

        <record id="action_matrice_configuration_form" model="ir.actions.act_window">
            <field name="name">Configuration de la matrice des prix</field>
            <field name="res_model">product.bareme.matrice</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_matrice_configuration"
                  action="action_matrice_configuration_form"
                  parent="product.menu_price" />


        <!-- Configuration promo -->
        <record id="pricelist_promo_configuration_form_view" model="ir.ui.view">
            <field name="name">pricelist.promo.configuration.form.view</field>
            <field name="model">pricelist.promo.configuration</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Configuration des promos">
                    <field name="name" colspan="4" readonly="1"/>
                    <field name="bareme_jaune" />
                </form>
            </field>
        </record>

        <record id="pricelist_promo_configuration_tree_view" model="ir.ui.view">
            <field name="name">pricelist.promo.configuration.tree.view</field>
            <field name="model">pricelist.promo.configuration</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Configuration des promos">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="action_pricelist_promo_configuration_form" model="ir.actions.act_window">
            <field name="name">Configuration des promos</field>
            <field name="res_model">pricelist.promo.configuration</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_pricelist_promo_configuration"
                  action="action_pricelist_promo_configuration_form"
                  parent="product.menu_price" />

        <!--Configuration mea-->
        <record id="pricelist_mea_configuration_form_view" model="ir.ui.view">
            <field name="name">pricelist.mea.configuration.form.view</field>
            <field name="model">pricelist.mea.configuration</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Configuration des mises en avant">
                    <field name="name" colspan="4" readonly="1"/>
                    <field name="bareme_jaune" />
                </form>
            </field>
        </record>

        <record id="pricelist_mea_configuration_tree_view" model="ir.ui.view">
            <field name="name">pricelist.mea.configuration.tree.view</field>
            <field name="model">pricelist.mea.configuration</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Configuration des mises en avant">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="action_pricelist_mea_configuration_form" model="ir.actions.act_window">
            <field name="name">Configuration des mises en avant</field>
            <field name="res_model">pricelist.mea.configuration</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_pricelist_mea_configuration"
                  action="action_pricelist_mea_configuration_form"
                  parent="product.menu_price" />

        <!-- Ajout des checkbox pour indiquer qu'une liste de prix contient les promos jaunes ou blanches -->
        <record id="inherit_promo_product_pricelist_form" model="ir.ui.view">
            <field name="name">inherit.promo.product.pricelist.form</field>
            <field name="model">product.pricelist</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='currency_id']" position="after">
                    <field name="mea_choice" />
                    <field name="promo_choice" />
                    <field name="tarif_choice" />
                </xpath>
            </field>
        </record>

        <record id="inherit_promo_product_pricelist_tree" model="ir.ui.view">
            <field name="name">inherit.promo.product.pricelist.tree</field>
            <field name="model">product.pricelist</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="product.product_pricelist_view_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='currency_id']" position="after">
                    <field name="mea_choice" />
                    <field name="promo_choice" />
                    <field name="tarif_choice" />
                </xpath>
            </field>
        </record>


        <!-- Ajout d'une checkbox pour indiquer que la version de LP est une version de base -->
        <record id="inherit_product_pricelist_version_form" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.version.form</field>
            <field name="model">product.pricelist.version</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_version_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='date_end']" position="after">
                    <field name="base_ok" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_pricelist_version_tree" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.version.tree</field>
            <field name="model">product.pricelist.version</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="product.product_pricelist_version_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='date_end']" position="after">
                    <field name="base_ok" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_pricelist_view_form_base" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.view.form.base</field>
            <field name="model">product.pricelist</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='version_id']/form/field[@name='date_end']" position="after" >
                    <field name="base_ok" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_pricelist_view_tree_base" model="ir.ui.view">
            <field name="name">inherit.product.pricelist.view.tree.base</field>
            <field name="model">product.pricelist</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='version_id']/tree/field[@name='date_end']" position="after" >
                    <field name="base_ok" />
                </xpath>
            </field>
        </record>

        <record id="product_tarif_special_client_tree_view" model="ir.ui.view">
            <field name="name">product.tarif.special.client.wizard.tree</field>
            <field name="model">product.tarif.special.client.wizard</field>
            <field name="type">tree</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <tree string="Produits en tarif spécial">
                    <field name="product_id"/>
                    <field name="prix_vente_initial"/>
                    <field name="prix_special"/>
                </tree>
            </field>
        </record>

        <record id="product_tarif_special_client_form_view" model="ir.ui.view">
            <field name="name">product.tarif.special.client.wizard.form</field>
            <field name="model">product.tarif.special.client.wizard</field>
            <field name="type">form</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Produits en tarif spécial">
                    <field name="product_id" on_change="on_change_product_id(product_id)"/>
                    <newline/>
                    <field name="prix_vente_initial"/>
                    <newline/>
                    <field name="prix_special"/>
                </form>
            </field>
        </record>

       <record id="product_nouveau_prix_achat_tree_view" model="ir.ui.view">
            <field name="name">product.nouveau.prix.achat.tree</field>
            <field name="model">product.nouveau.prix.achat</field>
            <field name="type">tree</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <tree string="Produits ayant un nouveau prix d'achat">
                    <field name="product_id"/>
                    <field name="ancien_prix_achat"/>
                    <field name="nouveau_prix_achat"/>
                </tree>
            </field>
        </record>

      <record id="product_nouveau_prix_achat_form_view" model="ir.ui.view">
            <field name="name">product.nouveau.prix.achat.form</field>
            <field name="model">product.nouveau.prix.achat</field>
            <field name="type">form</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Produits ayant un nouveau prix d'achat">
                    <field name="product_id" on_change="on_change_product_id(product_id, context)"/>
                    <newline/>
                    <field name="ancien_prix_achat" readonly="1"/>
                    <newline/>
                    <field name="nouveau_prix_achat"/>
                </form>
            </field>
        </record>

        <!-- Création de promo -->
        <record id="product_pricelist_promo_form_view" model="ir.ui.view">
            <field name="name">product.pricelist.promo.form.view</field>
            <field name="model">product.pricelist.promo</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Promo">
                    <field name="name" attrs="{'readonly': [('state', '=', 'done')]}" colspan="4"/>
                    <newline />
                    <field name="start_date" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="end_date" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <separator colspan="4" string="Produits" />
                    <field name="product_ids" colspan="4" nolabel="1" mode="tree" attrs="{'readonly': [('state', '=', 'done')]}">
                        <tree string="Produits" editable="top">
                            <field name="name" />
                            <field name="product_id" on_change="onchange_product(product_id)" string="Produit                                                                                                     "/>
                            <field name="prix_achat" />
                            <field name="new_prix_achat" />
                            <field name="prix_blanche" on_change="onchange_prix_blanche(product_id, prix_blanche)"/>
                            <field name="prix_jaune" />
                        </tree>
                    </field>
                    <field name="state" invisible="0" readonly="1"/>
                    <button icon="gtk-ok" name="_create_promo" string="Valider la promo" type="object" states="draft"/>
                    <button icon="gtk-cancel" name="_draft_promo" string="Mettre en brouillon" type="object" states="done"/>
                </form>
            </field>
        </record>

        <record id="product_pricelist_promo_tree_view" model="ir.ui.view">
            <field name="name">product.pricelist.promo.tree.view</field>
            <field name="model">product.pricelist.promo</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Promos">
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                </tree>
            </field>
        </record>

        <record id="act_product_pricelist_promo" model="ir.actions.act_window">
            <field name="name">Promos validées</field>
            <field name="res_model">product.pricelist.promo</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'done')]</field>
        </record>

        <record id="act_product_pricelist_promo_draft" model="ir.actions.act_window">
            <field name="name">Promos en brouillon</field>
            <field name="res_model">product.pricelist.promo</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'draft')]</field>
        </record>

        <record id="act_product_pricelist_promo_form" model="ir.actions.act_window">
            <field name="name">Configurer une promo</field>
            <field name="res_model">product.pricelist.promo</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
        </record>

        <menuitem
            id="menu_promos"
            name="Promotions"
            sequence="90"
            parent="product.menu_main_product" />

        <menuitem
            id="menu_product_pricelist_promo"
            sequence="3"
            action="act_product_pricelist_promo"
            parent="menu_promos" />

        <menuitem
            id="menu_product_pricelist_promo_draft"
            sequence="4"
            action="act_product_pricelist_promo_draft"
            parent="menu_promos" />

        <menuitem action="act_product_pricelist_promo_form"
                  sequence="2"
                  id="menu_pricelist_configure_promo"
                  parent="menu_promos" />

        <!--Création de MEA-->
        <record id="product_pricelist_mea_form_view" model="ir.ui.view">
            <field name="name">product.pricelist.mea.form.view</field>
            <field name="model">product.pricelist.mea</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Mea">
                    <field name="name" attrs="{'readonly': [('state', '=', 'done')]}" colspan="4"/>
                    <newline />
                    <field name="start_date" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="end_date" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <separator colspan="4" string="Produits" />
                    <field name="product_ids" colspan="4" nolabel="1" mode="tree" attrs="{'readonly': [('state', '=', 'done')]}">
                        <tree string="Produits" editable="top">
                            <field name="name" />
                            <field name="product_id" on_change="onchange_product(product_id)" string="Produit                                                                                                     "/>
                            <field name="prix_achat" />
                            <field name="new_prix_achat" />
                            <field name="new_prix_blanche" required="1"/>
                            <field name="new_prix_jaune" required="1"/>
                        </tree>
                    </field>
                    <field name="state" invisible="0" readonly="1"/>
                    <button icon="gtk-ok" name="_create_mea" string="Valider la mise en avant" type="object" states="draft"/>
                    <button icon="gtk-cancel" name="_draft_mea" string="Mettre en brouillon" type="object" states="done"/>
                </form>
            </field>
        </record>

        <record id="product_pricelist_mea_tree_view" model="ir.ui.view">
            <field name="name">product.pricelist.mea.tree.view</field>
            <field name="model">product.pricelist.mea</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Mises en avant">
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                </tree>
            </field>
        </record>

        <record id="act_product_pricelist_mea" model="ir.actions.act_window">
            <field name="name">MEA validées</field>
            <field name="res_model">product.pricelist.mea</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'done')]</field>
        </record>

        <record id="act_product_pricelist_mea_draft" model="ir.actions.act_window">
            <field name="name">MEA en brouillon</field>
            <field name="res_model">product.pricelist.mea</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'draft')]</field>
        </record>

        <record id="act_product_pricelist_mea_form" model="ir.actions.act_window">
            <field name="name">Configurer une MEA</field>
            <field name="res_model">product.pricelist.mea</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
        </record>

        <menuitem
            id="menu_mea"
            name="Mises en avant"
            sequence="90"
            parent="product.menu_main_product" />

        <menuitem
            id="menu_product_pricelist_mea"
            sequence="3"
            action="act_product_pricelist_mea"
            parent="menu_mea" />

        <menuitem
            id="menu_product_pricelist_mea_draft"
            sequence="4"
            action="act_product_pricelist_mea_draft"
            parent="menu_mea" />

        <menuitem action="act_product_pricelist_mea_form"
                  sequence="2"
                  id="menu_pricelist_configure_mea"
                  parent="menu_mea" />

        <record id="product_pricelist_tarifs_speciaux_form_view" model="ir.ui.view">
            <field name="name">product.pricelist.tarifs_speciaux.form.view</field>
            <field name="model">product.tarifs.speciaux</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Tarifs Spéciaux">
                    <field name="client"/>
                    <field name="name" />
                    <newline />
                    <field name="start_date" />
                    <field name="end_date" />
                    <separator colspan="4" string="Produits" />
                    <field name="product_id" colspan="4" nolabel="1" />
                </form>
            </field>
        </record>

        <record id="product_pricelist_tarifs_speciaux_tree_view" model="ir.ui.view">
            <field name="name">product.pricelist.tarifs.speciaux.tree.view</field>
            <field name="model">product.tarifs.speciaux</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Tarifs Spéciaux">
                    <field name="client" />
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                </tree>
            </field>
        </record>

        <record id="act_product_pricelist_tarifs_speciaux" model="ir.actions.act_window">
            <field name="name">Tarifs Spéciaux</field>
            <field name="res_model">product.tarifs.speciaux</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
           id="menu_product_pricelist_tarifs_speciaux"
            action="act_product_pricelist_tarifs_speciaux"
            parent="product.menu_product_pricelist_main" />

        <record id="view_product_tarif_special_client_tree" model="ir.ui.view">
            <field name="name">product.tarif.special.client.tree</field>
            <field name="model">product.tarif.special.client</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Tarifs Spéciaux">
                    <field name="product_id"/>
                    <field name="prix_special"/>
                </tree>
            </field>
        </record>

        <record id="view_product_tarif_special_client_form" model="ir.ui.view">
            <field name="name">product.tarif.special.client.form</field>
            <field name="model">product.tarif.special.client</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Tarifs Spéciaux">
                    <field name="product_id"/>
                    <field name="prix_special"/>
                </form>
            </field>
        </record>

    </data>
</openerp>

