  <story>
    <para style="P5">[[ setLang('fr_FR') ]]</para>
    <para style="P5">[[ repeatIn(objects, 'o') ]]</para>
    <blockTable colWidths="567.0" style="Table1">
      <tr>
        <td>
          <para style="P9">PRODUITS</para>
        </td>
      </tr>
    </blockTable>
    <para style="P1">
      <font color="white"> </font>
    </para>
    <section>
      <para style="P4">[[ repeatIn(data['form']['category_ids'], 'c') ]]</para>
      <blockTable colWidths="567.0" style="Table2">
        <tr>
          <td>
            <para style="P10">[[ getCategory(c) or '' ]]</para>
          </td>
        </tr>
      </blockTable>
      <para style="P4">
        <font color="white"> </font>
      </para>
      <para style="P4">
        <font color="white"> </font>
      </para>
      <blockTable colWidths="32.0,32.0,220.0,35.0,35.0,35.0,35.0,35.0,35.0,35.0,35.0" style="Table3">
        <tr>
          <td>
            <para style="P6">Prix de vente</para>
          </td>
          <td>
            <para style="P6">Code</para>
          </td>
          <td>
            <para style="P6">Nom</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme1_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme2_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme3_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme4_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme5_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme6_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme7_id', False)) ]]</para>
          </td>
          <td>
            <para style="P6">[[ getBareme(data['form'].get('bareme8_id', False)) ]]</para>
          </td>
        </tr>
        <tr>
          <td>
            <para style="P8">[[ repeatIn(getProducts(c), 'p') ]]</para>
            <para style="P8">[[ formatLang(p.list_price) ]]</para>
          </td>
          <td>
            <para style="P8">[[ p.default_code ]]</para>
          </td>
          <td>
            <para style="P7">[[ p.name ]]</para>
          </td>
          <td>
            <para style="P8">[[data['form'].get('bareme1_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme1_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme2_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme2_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme3_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme3_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme4_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme4_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme5_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme5_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme6_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme6_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme7_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme7_id', False))) or '' ]]</para>
          </td>
          <td>
            <para style="P8">[[ data['form'].get('bareme8_id', False) and formatLang(getPrice(p.list_price , data['form'].get('bareme8_id', False))) or '' ]]</para>
          </td>
        </tr>
      </blockTable>
      <para style="P4">
        <font color="white"> </font>
