<!-- Wizard pour exportation du tarif HILTON -->

<record id="wizard_export_tarif_hilton" model="ir.ui.view">
            <field name="name">Exporter le tarif HILTON</field>
            <field name="model">wizard.export.tarif.hilton</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Exportation du tarif HILTON                                                                                    ">
                    <separator colspan="4" string="Exportation du tarif HILTON                                                                      " />
                            <group col="4" states="choose">
                                <field invisible="1" name="state"/>
				<field nolabel = "1" height="22" colspan = "4" name ="avertissement"/>
				<newline/>
                                <field name="from_date"/>
				<newline/>
                                <field name="mensuel"/>
				<newline/>
                                <field name="hebdo"/>
                                <newline/>
                                <button icon="gtk-cancel" name="act_cancel" special="cancel" states="choose" string="Annulation" type="object"/>
                                <button icon="gtk-ok" name="act_getfile" states="choose" string="Génération du fichier" type="object"/>
                            </group>
                            <group col="4" states="get">
                                <separator string="Le tarif a été exporté"/>
                                <field height="50" colspan="4" name="advice" nolabel="1"/>
                                <newline/>
                                <field name="name" invisible="1"/>
                                <field name="data" nolabel="1" readonly="1" fieldname="name" width="500" height="500"/>
				<newline/>
                                <button icon="gtk-close" name="act_export_ok" states="get" string="Fin" type="object"/>
                            </group>
                            <separator colspan="4"/>
                </form>
            </field>
        </record>

        <record id="action_wizard_export_tarif_hilton" model="ir.actions.act_window">
            <field name="name">Exporter le tarif HILTON</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.export.tarif.hilton</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_wizard_export_tarif_hilton" 
                  id="menu_wizard_export_tarif_hilton"
                  parent="iller_product_pricelist_rapports_menu" />


<!-- Wizard pour exportation des tarifs commerciaux -->

<record id="wizard_export_tarifs_commerciaux" model="ir.ui.view">
            <field name="name">Exporter le tarif des commerciaux</field>
            <field name="model">wizard.export.tarifs.commerciaux</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Exportation du tarif des commerciaux                                                              ">
                    <separator colspan="4" string="Export du tarif des commerciaux                                                              " />
                    <group colspan="4" col="4">
                            <group col="4" states="choose" colspan="4">
                                <field invisible="1" name="state"/>
                                <field nolabel = "1" height="44" colspan="4" name ="avertissement"/>
                                <newline/>
                                <field name="from_date"/>
                                <newline/>
                                <field name="achat_inclus"/>
                                <newline/>
                                <button icon="gtk-cancel" name="act_cancel" special="cancel" states="choose" string="Annulation" type="object"/>
                                <button icon="gtk-ok" name="act_getfile" states="choose" string="Génération du fichier" type="object"/>
                            </group>
                            <group col="4" states="get" colspan="4">
                                <separator string="Le tarif a été exporté" colspan="4"/>
                                <field height="50" colspan="4" name="advice" nolabel="1"/>
                                <newline/>
                                <field name="name" invisible="1"/>
                                <field name="data" nolabel="1" readonly="1" fieldname="name"/>
                                <newline/>
                                <button icon="gtk-close" name="act_export_ok" states="get" string="Fin" type="object"/>
                            </group>
                            <separator colspan="4"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_wizard_export_tarifs_commerciaux" model="ir.actions.act_window">
            <field name="name">Exporter le tarif des commerciaux</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.export.tarifs.commerciaux</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_wizard_export_tarifs_commerciaux" 
                  id="menu_wizard_export_tarifs_commerciaux"
                  parent="iller_product_pricelist_rapports_menu" />

        <!-- Wizard de modification des coefficients par catégorie -->
        <record id="wizard_choose_category_view" model="ir.ui.view">
            <field name="name">wizard.choose.category.view</field>
            <field name="model">wizard.choose.category</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Choix de la catégorie">
                    <field name="category_id" colspan="4" />
                    <field name="type" colspan="4" />
                    <button name="_choose" string="Continuer" type="object" colspan="4" />
                </form>
            </field>
        </record>

        <record id="action_choose_category" model="ir.actions.act_window">
            <field name="name">Modification des coefficients par catégorie</field>
            <field name="res_model">wizard.choose.category</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_choose_category" 
                  id="menu_choose_category"
                  parent="product.menu_product_pricelist_main" />

        <record id="wizard_modif_coeff_view" model="ir.ui.view">
            <field name="name">wizard.modif.coeff.view</field>
            <field name="model">wizard.modif.coeff</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="" editable="top">
                    <field name="name" />
                    <field name="coeff_new" />
                </tree>
            </field>
        </record>


        <!-- Wizard d'impression des listes de prux par catégorie -->
        <record id="wizard_print_pricelist_cat_view" model="ir.ui.view">
            <field name="name">wizard.print.pricelist.cat.view</field>
            <field name="model">wizard.print.pricelist.cat</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Impression des prix">
                    <separator string="Impression des prix" colspan="4" />
                    <group colspan="2" col="2">
                        <separator string="Barèmes" />
                        <field name="bareme1_id" />
                        <field name="bareme2_id" />
                        <field name="bareme3_id" />
                        <field name="bareme4_id" />
                        <field name="bareme5_id" />
                        <field name="bareme6_id" />
                        <field name="bareme7_id" />
                        <field name="bareme8_id" />
                    </group>
                    <group colspan="2" col="2">
                        <separator string="Catégories" colspan="2" />
                        <field name="category_ids" nolabel="1" colspan="2" />
                    </group>
                    <button name="_print" string="Imprimer" colspan="4" type="object" />
                </form>
            </field>
        </record>

        <record id="action_print_pricelist_cat" model="ir.actions.act_window">
            <field name="name">Impression des catégories par barème</field>
            <field name="res_model">wizard.print.pricelist.cat</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_print_pricelist_cat" 
                  id="menu_print_cat_bareme"
                  parent="iller_product_pricelist_rapports_menu" />

    </data>
