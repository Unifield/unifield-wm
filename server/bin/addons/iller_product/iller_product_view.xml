<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <!-- Modification de la vue des produits -->
        <record id="iller_inherit1_product_normal_form_view" model="ir.ui.view">
            <field name="name">product.normal.form</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <page string="Descriptions" position="after">
                    <page string = "Info spéc.">
                        <field name="code_emballage"/>
                        <field name="type_etiq_art"/>
                        <field name="type_emballage"/>
                        <field name="type_condit"/>
                        <field name="type_pesee"/>
                        <field name="nu_par_etiq_art"/>
                        <field name="code_affection"/>
                        <field name="localisation"/>
                        <field name="col_promo_p2"/>
                        <field name="liste_prep"/>
                        <field name="coef_promo_blanc"/>
                        <field name="compl_lib"/>
                        <field name="cond_vente"/>
                    </page>
                </page>
            </field>
        </record>

        <record id="iller_inherit2_product_normal_form_view" model="ir.ui.view">
            <field name="name">product.normal.form</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <field name="list_price" position="replace">
                    <field name="prix_achat"/>
                    <field name="coef_depart" on_change="onchange_coef_depart(prix_achat,coef_depart)"/>
                    <field name="prix_depart"/>
                    <field name="coef_collectiv" on_change="onchange_coef_collectiv(prix_achat,coef_collectiv)"/>
                    <field name="prix_depart_collectiv"/>
                </field>
            </field>
        </record>

        <record id="iller_inherit3_product_normal_form_view" model="ir.ui.view">
            <field name="name">product.normal.form</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <field name="standard_price" position="replace">
                    <field name="standard_price" string="P.Achat.M.P."/>
                </field>
            </field>
        </record>

    </data>
</openerp>
