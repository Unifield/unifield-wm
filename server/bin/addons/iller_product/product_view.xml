<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <!-- Suppression des wizards -->
        <delete model="ir.actions.wizard" search="[('wiz_name', '=', 'product_price'), ('name', '=', 'Product Cost Structure')]" />
        <delete model="ir.actions.wizard" search="[('wiz_name', '=', 'product.product.procurement'), ('name', '=', 'Procurement Request')]" />
        <!--        <delete model="ir.actions.wizard" search="[('wiz_name', '=', ''), ('name', '=', '')]" />-->

        <delete model="ir.actions.act_window" search="[('name', '=', 'Bill of Materials'), ('res_model', '=', 'mrp.bom'), ('src_model', '=', 'product.product')]" />
        <delete model="ir.actions.act_window" search="[('name', '=', 'Minimum Stock Rules'), ('res_model', '=', 'stock.warehouse.orderpoint'), ('src_model', '=', 'product.product')]" />

        <!-- Suppression des reports -->
        <delete model="ir.actions.report.xml" search="[('name', '=', 'Future Stock Forecast'), ('model', '=', 'product.product'), ('report_name', '=', 'stock.product.history')]" />
        <delete model="ir.actions.report.xml" search="[('name', '=', 'Products Labels'), ('model', '=', 'product.product'), ('report_name', '=', 'product.product.label')]" />

        <record id="inherit_product_category_form_view" model="ir.ui.view">
            <field name="name">inherit.product.category.form.view</field>
            <field name="model">product.category</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_category_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/field[@name='name']" position="after">
                    <field name="code" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_normal_form_view1" model="ir.ui.view">
            <field name="name">inherit.product.normal.form.view1</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Prices &amp; Suppliers']" position="replace">
                    <page string='Prices &amp; Suppliers'>
                        <group colspan="2" col="2">
                            <separator string="Achat" />
                            <field name="standard_price" readonly="1"/>
                            <field name="prix_achat" on_change="coeff_price_change(prix_achat, coeff_depart, coeff_blanche)" required="1" readonly="0" />
                            <field name="coeff_depart" on_change="coeff_price_change(prix_achat, coeff_depart, coeff_blanche)" required="1" />
                            <field groups="base.group_extended" name="cost_method"/>
                        </group>
                        <group colspan="2" col="2">
                            <separator string="Vente" />
                            <field name="list_price" readonly="1"/>
                            <field name="price_margin" select="1"/>
                            <field name="price_extra" select="1"/>
                            <field name="type_cond" on_change="cond_onchange(type_cond, type_preselec)" required="1"/>
                            <field name="type_preselec" on_change="preselec_onchange(type_cond, type_preselec)" required="1"/>
                        </group>
			<separator colspan="4" />
                        <field colspan="4" mode="tree,form" name="price_history" nolabel="1" widget="one2many_list" readonly="1">
                               <form>
                                     <field name="name"/>
                                     <field name="nouveau_prix_achat"/>
                                     <field name="nouveau_prix_vente"/>
                                     <field name="comment" />
                               </form>
                              <tree string = "Historique des Prix">
                                     <field name="name"/>
                                     <field name="nouveau_prix_achat"/>
                                     <field name="nouveau_prix_vente"/>
                                     <field name="comment" />
                               </tree>
                        </field>
                        <separator colspan="4" string="Promos" />
                        <field name="coeff_blanche" on_change="promo_blanche_change(coeff_blanche, prix_achat)" required="1" />
                        <field name="prix_blanche" readonly="1" />
<!--
                        <field name="coeff_jaune" />
-->
                        <field name="prix_decembre" />
			<newline/>
                        <field colspan="4" name="seller_ids" nolabel="1"/>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="iller_product_product_tree_view" model="ir.ui.view">
            <field name="name">iller.product.tree.view</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_product_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='standard_price']" position="replace">
                    <field name="prix_achat" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_normal_form_view2" model="ir.ui.view">
            <field name="name">inherit.product.normal.form.view2</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Information']/group[2]/field[@name='weight_net']" position="after">
                    <field name="type_pesee" />
                    <field name="code_affectation" attrs="{'required': [('type_pesee', 'in', ('7','8'))]}" />
                </xpath>
            </field>
        </record>

        <record id="inherit_product_normal_form_view3" model="ir.ui.view">
            <field name="name">inherit.product.normal.form.view3</field>
            <field name="model">product.product</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Information']/group/field[@name='supply_method']" position="after">
                    <field name="liste_prepa" />
                </xpath>
            </field>
        </record>

    </data>
</openerp>
