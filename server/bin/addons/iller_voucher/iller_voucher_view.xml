<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="inherit_view_voucher_form1" model="ir.ui.view">
            <field name="name">inherit.view.voucher.form1</field>
            <field name="model">account.voucher</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account_voucher.view_voucher_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[@string='Entry Lines']/field[@name='payment_ids']" position="replace">
                    <field name="payment_ids" colspan="4" nolabel="1" height="275">
                        <tree string="Lignes de Souches" editable="top">
                            <field name="account_analytic_id" />
                            <field name="partner_id" on_change="onchange_partner(partner_id,type,parent.type)" required="1" />
                            <field name="account_id" required="1" />
                            <field name="name" />
                            <field name="type" />
                            <field name="amount" />
                            <field name="voucher_move_id" domain="[('id', '=', '0')]" context="{'partner_id': partner_id, 'account_id': account_id, 'amount': amount}" />
                            <field name="ref" />
                        </tree>
                        <form string="Lignes de Souches" >
                            <field name="partner_id" on_change="onchange_partner(partner_id,type,parent.type)" required="1" />
                            <field name="account_id" required="1" />
                            <field name="name" />
                            <field name="type" />
                            <field name="amount" />
                            <field name="voucher_move_id" domain="[('id', '=', '0')]" context="{'partner_id': partner_id, 'account_id': account_id, 'amount': amount}" />
                            <field name="ref" />
                        </form>
                    </field>
                </xpath>
            </field>
        </record>

        <record id="account_voucher_move_line_form" model="ir.ui.view">
            <field name="name">account.voucher.move.line.form</field>
            <field name="model">account.voucher.move.line</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Lignes d'écriture">
                    <field name="name" colspan="4" required="1" />
                    <field name="amount" />
                    <field name="move_line_ids" nolabel="1" colspan="4" domain="[('partner_id','=',context.get('partner_id', False)), ('account_id', '=', context.get('account_id')),('reconcile_id', '=', False)]" on_change="onchange_move_lines(move_line_ids, line_new_ids)"/>
                    <field name="line_new_ids" nolabel="1" colspan="4" on_change="onchange_move_lines(move_line_ids, line_new_ids)">
                        <tree string="Ajustements" editable="top">
                            <field name="account_id" required="1" domain="[('type','&lt;&gt;','view'),('type','&lt;&gt;','consolidation')]" />
                            <field name="amount" required="1" />
                            <field name="name" required="1" />
                        </tree>
                    </field>
                    <field name="total_entries" readonly="1" />
                    <field name="balance" readonly="1" />
                    <field name="total_writeoff" readonly="1" />
                    <button name="compute_total_entries" type="object" string="Calculer" colspan="2" />
                </form>
            </field>
        </record>

        <!-- CRÉATION D'UN MENU PORTEFEUILLE -->
        <menuitem id="iller_portefeuille"
                  name="Portefeuilles"
                  parent="account.menu_finance" />

        <record id="act_iller_portefeuille_cheque" model="ir.actions.act_window">
            <field name="name">Portefeuille Chèques</field>
            <field name="res_model">account.move.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('account_id.code', 'like', '41360000'), ('reconcile_id', '=', False)]</field>
        </record>

        <menuitem id="iller_portefeuille_cheque"
                  action="act_iller_portefeuille_cheque"
                  parent="iller_portefeuille" />

        <record id="act_iller_portefeuille_traite" model="ir.actions.act_window">
            <field name="name">Portefeuille Traites</field>
            <field name="res_model">account.move.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('account_id.code', 'like', '41370000'), ('reconcile_id', '=', False)]</field>
        </record>

        <menuitem id="iller_portefeuille_traite"
                  action="act_iller_portefeuille_traite"
                  parent="iller_portefeuille" />

        <record id="act_iller_portefeuille_reglement" model="ir.actions.act_window">
            <field name="name">Portefeuille règlements</field>
            <field name="res_model">account.move.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('account_id.code', 'in', ('41360000', '41370000')), ('reconcile_id', '=', False)]</field>
        </record>

        <menuitem id="iller_portefeuille_regelement"
                  action="act_iller_portefeuille_reglement"
                  parent="iller_portefeuille" />

    </data>
</openerp>
