<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="inherit_partner_code_account_move_line" model="ir.ui.view">
            <field name="name">inherit.partner.code.account.move.line</field>
            <field name="model">account.move.line</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="account.view_move_line_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree/field[@name='partner_id']" position="before">
                    <field name="partner_code" select="1" />
                </xpath>
            </field>
        </record>

        <record id="inherit_partner_code_account_move_line_form" model="ir.ui.view">
            <field name="name">inherit.partner.code.account.move.line.form</field>
            <field name="model">account.move.line</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_move_line_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page/field[@name='partner_id']" position="before">
                    <field name="partner_code" select="1" />
                </xpath>
            </field>
        </record>

        <record id="inherit_partner_code_account_move_line_form2" model="ir.ui.view">
            <field name="name">inherit.partner.code.account.move.line.form2</field>
            <field name="model">account.move.line</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_move_line_form2" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page/field[@name='partner_id']" position="before">
                    <field name="partner_code" select="1" />
                </xpath>
            </field>
        </record>

    </data>
</openerp>
