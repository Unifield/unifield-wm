<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
    
        <record id="inherit_product_product_tree_view" model="ir.ui.view">
            <field name="name">inherit.product.product.tree</field>
            <field name="model">product.product</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="product.product_product_tree_view" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/tree/field[@name='name']" position='after'>
                        <field name="derniere_date" invisible="not 'partner_id' in context" />
                        <field name="derniere_quantite" invisible="not 'partner_id' in context"/>
                    </xpath>
                </data>
            </field>
        </record>
        
    </data>
</openerp>
