<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
    
        <record id="inherit_sale_order_form_view" model="ir.ui.view">
            <field name="name">inherit.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page[1]/field[@name='order_line']/form/notebook/page[1]/field[@name='product_id']" position='replace'>
                    <field colspan="4" context="{'partner_id':parent.partner_id,'quantity':product_uom_qty,'pricelist':parent.pricelist_id,'shop':parent.shop_id,'uom':product_uom,'from':'sale.order.line'}" name="product_id" on_change="product_id_change(parent.pricelist_id,product_id,product_uom_qty,product_uom,product_uos_qty,product_uos,name,parent.partner_id, 'lang' in context and context['lang'], True, parent.date_order, product_packaging, parent.fiscal_position)" select="1"/>
                </xpath>
            </field>
        </record>
        
    </data>
</openerp>
