<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="iller_view_picking_out_form" model="ir.ui.view">
            <field name="name">iller.view.picking.out.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_out_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/form/notebook/page/group[2]/button[@string='Packing Done']" position="replace">
                        <button name="%(iller_partial_picking)d" states="assigned" string="Packing Done" type="action"/>
                    </xpath>

                    <xpath expr="/form/group/field[@name='min_date']" position="replace">
                        <field name="min_date" string="Date exp." widget="date" />
                    </xpath>
                </data>
            </field>
        </record>

        <!--
        Action pour créer un menu qui filtre sur les stock picking disponibles
        -->
        <record id="action_picking_iller_dispo_tree1" model="ir.actions.act_window">
            <field name="name">Commandes à préparer</field>
            <field name="res_model">stock.picking</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="domain">[('state','=','assigned'),('type','=','out')]</field>
            <field name="context">{'contact_display': 'partner'}</field>
            <field name="view_id" ref="stock.view_picking_out_tree"/>
        </record>
        <record id="action_picking_tree_out_iller_dispo" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="stock.view_picking_out_tree"/>
            <field name="act_window_id" ref="action_picking_iller_dispo_tree1"/>
        </record>
        <record id="action_picking_form_out_iller_dispo" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="stock.view_picking_out_form"/>
            <field name="act_window_id" ref="action_picking_iller_dispo_tree1"/>
        </record>

        <!--
        Action pour créer un menu qui filtre sur les stock picking terminées
        -->
        <record id="action_picking_iller_envoyees_tree1" model="ir.actions.act_window">
            <field name="name">Commandes envoyées</field>
            <field name="res_model">stock.picking</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="domain">[('state','=','done'),('type','=','out')]</field>
            <field name="context">{'contact_display': 'partner'}</field>
            <field name="view_id" ref="stock.view_picking_out_tree"/>stock
        </record>
        <record id="action_picking_tree_out_iller_envoyees" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="stock.view_picking_out_tree"/>
            <field name="act_window_id" ref="action_picking_iller_envoyees_tree1"/>
        </record>
        <record id="action_picking_form_out_iller_envoyees" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="stock.view_picking_out_form"/>
            <field name="act_window_id" ref="action_picking_iller_envoyees_tree1"/>
        </record>

        <!--
        Menus pour les deux nouvelles actions (menu_stock_root ou menu_action_picking_tree ?)
        -->
        <menuitem
                action="action_picking_iller_dispo_tree1"
                id="menu_picking_iller_dispo"
                parent="stock.menu_stock_root"
                />
        <menuitem
                action="action_picking_iller_envoyees_tree1"
                id="menu_picking_iller_envoyees"
                parent="stock.menu_stock_root"
                />

    </data>
</openerp>
