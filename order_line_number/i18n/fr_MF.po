#: model:ir.model,name:order_line_number.model_procurement_order
msgid "Procurement"
msgstr "Approvisionnement"

#. module: order_line_number
#: constraint:purchase.order:0
msgid "You must specify a Valid Till date."
msgstr "Spécifiez une date de validité 'Valide Jusque'."

#. module: order_line_number
#: constraint:supplier.catalogue:0
msgid "The 'To' date mustn't be younger than the 'From' date !"
msgstr "La date 'A' doit être postérieure à la date 'De' !"

#. module: order_line_number
#: constraint:purchase.order:0
msgid "If you tick the box \"cross docking\", you cannot have an other location than \"Cross docking\""
msgstr "Si vous cochez la case \"transbordement\", vous ne pouvez pas avoir d'autre lieu que \"Transbordement\""

#. module: order_line_number
#: constraint:purchase.order:0
#: constraint:sale.order:0
msgid "Partner type and order type are incompatible! Please change either order type or partner."
msgstr "Le type de partnenaire et le type de commande sont incompatibles. Veuillez changer l'un ou l'autre."

#. module: order_line_number
#: sql_constraint:purchase.order:0
#: sql_constraint:sale.order:0
msgid "Order Reference must be unique !"
msgstr "La Référence de la Commande doit être unique !"

#. module: order_line_number
#: constraint:sale.order.line:0
msgid "You must select on order procurement method for Service with Reception products."
msgstr "Vous devez sélectionner sur la commande le mode d'approvisionnement pour le Service  avec Réception de produits."

#. module: order_line_number
#: model:ir.module.module,description:order_line_number.module_meta_information
