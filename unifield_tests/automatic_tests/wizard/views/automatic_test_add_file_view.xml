<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <record id="automatic_test_add_file_form_view" model="ir.ui.view">
            <field name="name">automatic.test.add.file.form.view</field>
            <field name="model">automatic.test.add.file</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Add file">
                    <separator colspan="4" string="Test case" />
                    <field name="test_id" />
                    <separator colspan="4" string="Data file" />
                    <field name="data_file" />
                    <separator colspan="4" string="Actions" />
                    <label colspan="2" string="" />
                    <button name="add_file" type="object" string="Add file" icon="gtk-execute" colspan="2" />
                </form>
            </field>
        </record>

    </data>
</openerp>
