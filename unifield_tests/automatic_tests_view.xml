<?xml version="1.0" encoding="utf-8" ?>
<openerp>
    <data>

        <!-- TEST TEMPLATE -->
        <record id="automatic_test_template_tree_view" model="ir.ui.view">
            <field name="name">automatic.test.template.tree.view</field>
            <field name="model">automatic.test.template</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Automatic test templates">
                    <field name="name" />
                    <field name="test_class" />
                    <field name="test_type" />
                </tree>
            </field>
        </record>

        <record id="automatic_test_template_search_view" model="ir.ui.view">
            <field name="name">automatic.test.template.search.view</field>
            <field name="model">automatic.test.template</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Automatic test templates">
                    <field name="name" />
                    <field name="test_class" />
                    <field name="test_type" />
                </search>
            </field>
        </record>

        <!-- AUTOMATIC TEST -->
        <record id="automatic_test_form_view" model="ir.ui.view">
            <field name="name">automatic.test.form.view</field>
            <field name="model">automatic.test</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Automatic test">
                    <field name="template_id" />
                    <newline />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="state" />
                    <separator colspan="4" string="Tests" />
                    <field name="method_ids" mode="tree,form" readonly="True" colspan="4" nolabel="1">
                        <tree string="Tests" colors="red: state=='error'; green: state=='done'; orange: state=='fail'; grey: state=='skip'; blue: state=='progress'">
                            <field name="name" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="state" />
                        </tree>
                        <form string="Tests">
                            <field name="test_id" />
                            <field name="name" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="state" />
                            <newline />
                            <field colspan="4" name="message" widget="char" />
                            <separator colspan="4" string="Traceback" />
                            <field name="traceback" colspan="4" nolabel="1" />
                        </form>
                    </field>
                </form>
            </field>
        </record>

        <!-- TEST CAMPAIGN -->
        <record id="automatic_test_campaign_form_view" model="ir.ui.view">
            <field name="name">automatic.test.campaign.form.view</field>
            <field name="model">automatic.test.campaign</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Automatic test campaign">
                    <separator colspan="4" string="Campaign parameters" />
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <notebook colspan="4">
                        <page string="Test cases">
                            <field name="test_template_ids" colspan="4" mode="tree" nolabel="True">
                                <tree string="Test cases">
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>
                        <page string="Running tests">
                            <button colspan="4" type="object" name="update" icon="gtk-refresh" string="Update" states="progress" />
                            <field name="test_ids" colspan="4" mode="tree,form" readonly="True" nolabel="True">
                                <tree string="Running tests" colors="red: state=='error'; green: state=='done'; orange: state=='fail'; grey: state=='skip'; blue: state=='progress'">
                                    <field name="template_id" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <separator colspan="4" string="Status" />
                    <field name="state" />
                    <button colspan="2" type="object" name="run_campaign" icon="gtk-execute" string="Run campaign" states="not_run" />
                </form>
            </field>
        </record>

        <record id="automatic_test_campaigne_tree_view" model="ir.ui.view">
            <field name="name">automatic.test.campaign.tree.view</field>
            <field name="model">automatic.test.campaign</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Automatic test campaigns">
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="action_automatic_test_campaign" model="ir.actions.act_window">
            <field name="name">Automatic test campaign</field>
            <field name="res_model">automatic.test.campaign</field>
            <field name="view_mode">tree,form</field>
            <field name="view_type">form</field>
        </record>

        <menuitem
            action="action_automatic_test_campaign"
            id="menu_automatic_test_campaign"
            parent="menu_automatic_tests" />

    </data>
</openerp>
